# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it should already be in .gitignore.

# ---------------------------------------------------------------------------
# Database (MariaDB / MySQL)
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://user:password@host:25060/dbname?sslaccept=accept_invalid_certs"
DATABASE_HOST="host.example.com"
DATABASE_PORT="25060"
DATABASE_USER="user"
DATABASE_PASSWORD="password"
DATABASE_NAME="defaultdb"
DATABASE_SSL_MODE="required"

# ---------------------------------------------------------------------------
# Session HMAC secret — REQUIRED in production. Generate with:
#   openssl rand -base64 48
# ---------------------------------------------------------------------------
AUTH_SECRET="generate-a-long-random-string"
# Note: AUTH_SECRET also signs the Altomate Accounting -> AltomateHR SSO
# hand-off token (see /api/v1/admin/sso-ticket + /api/sso/altomate). No
# separate SSO secret is needed — HR signs and verifies it itself; the
# master API key is the only credential Accounting holds.

# ---------------------------------------------------------------------------
# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# ---------------------------------------------------------------------------
# WhatsApp (Wazzup24) — powers the employee Forgot Password flow
# (6-digit code). The reset action looks up the employee's
# PayrollProfile.phone (chained through EmployeeProfile), normalises
# it via lib/whatsapp.normalisePhone, and POSTs a free-form message
# via Wazzup's HTTP API.
#
# Generate WAZZUP_API_KEY in the Wazzup dashboard at
#   https://wazzup24.com → Settings → API
# Grab WAZZUP_CHANNEL_ID from
#   Settings → Channels (the UUID of the WhatsApp channel to send from).
#
# WAZZUP_DEFAULT_COUNTRY_CODE is the digits to prepend when an
# EmployeeProfile.phone starts with "0" (legacy local format).
# Defaults to "60" (Malaysia) when unset.
#
# When WAZZUP_API_KEY or WAZZUP_CHANNEL_ID are unset, password-reset
# WhatsApp sends silently skip in local dev (the action still returns
# "if account exists, check WhatsApp"). Production MUST configure
# these or no code ever reaches the user.
# ---------------------------------------------------------------------------
WAZZUP_API_KEY=""
WAZZUP_CHANNEL_ID=""
WAZZUP_DEFAULT_COUNTRY_CODE="60"

# ---------------------------------------------------------------------------
# Xero OAuth — register an app at https://developer.xero.com
# ---------------------------------------------------------------------------
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
# Note: the OAuth redirect URI is derived dynamically from the incoming
# request host (`getRequestOrigin(request)` → `{origin}/api/xero/callback`)
# so the app works across multiple hosts (e.g. hr.altomate.io AND
# altomatehr.fusioneta.com.my) without an env override. Every host you
# serve from must be registered as an allowed redirect URI in the Xero
# Developer Portal — Xero supports multiple per app.
XERO_SCOPES="openid profile email offline_access accounting.invoices accounting.banktransactions accounting.contacts accounting.settings accounting.manualjournals projects files"
# Bump this string to force all admins to re-grant Xero scopes after the
# scope list changes. Any non-empty value works.
XERO_REAUTH_VERSION="initial"

# ---------------------------------------------------------------------------
# Public geocoding key (browser-exposed — see NEXT_PUBLIC_ prefix)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GEOAPIFY_API_KEY=""

# ---------------------------------------------------------------------------
# AI providers.
#  - Receipt OCR uses Gemini's multimodal endpoint (the file is uploaded
#    directly; no client-side OCR step). Set GEMINI_API_KEY.
#  - The CSV employee-import mapper tries Groq first and falls back to
#    Gemini on failure (rate limit, etc.), so for imports set BOTH keys.
# Optionally override the Gemini model with GEMINI_MODEL (default
# gemini-2.5-flash) or the Groq model with GROQ_MODEL.
# ---------------------------------------------------------------------------
GROQ_API_KEY=""
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"
# GROQ_MODEL="llama-3.3-70b-versatile"

# ---------------------------------------------------------------------------
# Redis cache. Optional — when unset, cache becomes a pass-through.
# ---------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379/1"
REDIS_KEY_PREFIX="dev:altomatehr"

# ---------------------------------------------------------------------------
# Shared secret for /api/cron/* endpoints. Generate with:
#   openssl rand -hex 32
# cPanel cron job must send: Authorization: Bearer $CRON_SECRET
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Critical-error WhatsApp alerts (replaces Sentry).
#
# Comma-separated list of phone numbers that should receive WhatsApp
# notifications when log.critical(...) fires server-side IN PRODUCTION
# only. Empty → notifier no-ops and logs a console warning.
#
# Format: digits-only international numbers, no "+", no spaces.
#   "60123456789,60198765432"
# Local-format numbers ("0123456789") are auto-prefixed using
# WAZZUP_DEFAULT_COUNTRY_CODE.
#
# Uses the same WAZZUP_API_KEY / WAZZUP_CHANNEL_ID configured above for
# password-reset OTPs — no additional credentials required.
#
# Dedupe: identical (event + error message + first stack frame) within
# 10 minutes is suppressed to prevent burst-spam.
# ---------------------------------------------------------------------------
WAZZUP_ERROR_NOTIFY_PHONES=""
