# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it should already be in .gitignore.

# ---------------------------------------------------------------------------
# Database (MariaDB / MySQL)
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://user:password@host:25060/dbname?sslaccept=accept_invalid_certs"
DATABASE_HOST="host.example.com"
DATABASE_PORT="25060"
DATABASE_USER="user"
DATABASE_PASSWORD="password"
DATABASE_NAME="defaultdb"
DATABASE_SSL_MODE="required"

# ---------------------------------------------------------------------------
# Session HMAC secret — REQUIRED in production. Generate with:
#   openssl rand -base64 48
# ---------------------------------------------------------------------------
AUTH_SECRET="generate-a-long-random-string"
# Note: AUTH_SECRET also signs the Altomate Accounting -> AltomateHR SSO
# hand-off token (see /api/v1/admin/sso-ticket + /api/sso/altomate). No
# separate SSO secret is needed — HR signs and verifies it itself; the
# master API key is the only credential Accounting holds.

# ---------------------------------------------------------------------------
# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# ---------------------------------------------------------------------------
# Email — powers the employee Forgot Password flow (6-digit code).
# Uses Brevo's HTTP API (was SMTP — switched because DigitalOcean
# blocks outbound SMTP ports 25/465/587 on new droplets to prevent
# spam abuse). The HTTP API hits Brevo on port 443 which is always
# open.
#
# Generate BREVO_API_KEY at https://app.brevo.com/settings/keys/api
# (SMTP & API → API Keys → Create a new API key).
#
# MAIL_FROM_ADDRESS must be on a domain you've verified inside Brevo
# under Senders & IPs → Domains. The MAIL_* vars used to drive SMTP
# are no longer read (kept commented in case we add a self-hosted
# fallback later).
#
# When BREVO_API_KEY is unset, password-reset emails silently skip
# in local dev (the action still returns "if account exists, check
# your email" so the UX isn't broken). Production MUST configure
# these or no code ever reaches the user.
# ---------------------------------------------------------------------------
BREVO_API_KEY=""
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="AltomateHR"

# Legacy SMTP env vars — no longer read by lib/email.ts after the
# Brevo HTTP-API switch. Kept here as documentation in case a future
# code change re-introduces an SMTP path (e.g. if Brevo is replaced
# by self-hosting from a non-DO host).
# MAIL_HOST=""
# MAIL_PORT="465"
# MAIL_USERNAME=""
# MAIL_PASSWORD=""
# MAIL_ENCRYPTION="ssl"

# ---------------------------------------------------------------------------
# Xero OAuth — register an app at https://developer.xero.com
# ---------------------------------------------------------------------------
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_REDIRECT_URI="http://localhost:3000/api/xero/callback"
XERO_SCOPES="openid profile email offline_access accounting.invoices accounting.banktransactions accounting.contacts accounting.settings accounting.manualjournals projects files"
# Bump this string to force all admins to re-grant Xero scopes after the
# scope list changes. Any non-empty value works.
XERO_REAUTH_VERSION="initial"

# ---------------------------------------------------------------------------
# Public geocoding key (browser-exposed — see NEXT_PUBLIC_ prefix)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GEOAPIFY_API_KEY=""

# ---------------------------------------------------------------------------
# AI provider (OCR receipt analysis). Choose one and set AI_PROVIDER.
# Receipt OCR defaults to Gemini. The CSV employee-import mapper always
# tries Groq first and falls back to Gemini on failure (e.g. rate limit),
# so for imports it's best to set BOTH keys.
# Optionally override the Gemini model with GEMINI_MODEL (default
# gemini-2.5-flash) or the Groq model with GROQ_MODEL.
# ---------------------------------------------------------------------------
GROQ_API_KEY=""
GEMINI_API_KEY=""
AI_PROVIDER="gemini"
# GEMINI_MODEL="gemini-2.5-flash"
# GROQ_MODEL="llama-3.3-70b-versatile"

# ---------------------------------------------------------------------------
# Redis cache. Optional — when unset, cache becomes a pass-through.
# ---------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379/1"
REDIS_KEY_PREFIX="dev:altomatehr"

# ---------------------------------------------------------------------------
# Shared secret for /api/cron/* endpoints. Generate with:
#   openssl rand -hex 32
# cPanel cron job must send: Authorization: Bearer $CRON_SECRET
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Sentry error monitoring. All four are optional — when DSN is unset, the
# Sentry SDK no-ops and the app behaves as if it isn't installed.
#
# DSN is split into NEXT_PUBLIC_ (browser bundle) and the unprefixed
# server variant. They can point at the same project.
#
# AUTH_TOKEN is only needed at build time for source-map upload (so
# production stack traces are readable). Generate at:
#   https://sentry.io/settings/account/api/auth-tokens/
# Scope it to "project:releases" + "project:write" for the project below.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
