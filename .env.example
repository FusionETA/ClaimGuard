# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it should already be in .gitignore.

# ---------------------------------------------------------------------------
# Database (MariaDB / MySQL)
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://user:password@host:25060/dbname?sslaccept=accept_invalid_certs"
DATABASE_HOST="host.example.com"
DATABASE_PORT="25060"
DATABASE_USER="user"
DATABASE_PASSWORD="password"
DATABASE_NAME="defaultdb"
DATABASE_SSL_MODE="required"

# ---------------------------------------------------------------------------
# Session HMAC secret — REQUIRED in production. Generate with:
#   openssl rand -base64 48
# ---------------------------------------------------------------------------
AUTH_SECRET="generate-a-long-random-string"

# ---------------------------------------------------------------------------
# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# ---------------------------------------------------------------------------
# Xero OAuth — register an app at https://developer.xero.com
# ---------------------------------------------------------------------------
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_REDIRECT_URI="http://localhost:3000/api/xero/callback"
XERO_SCOPES="openid profile email offline_access accounting.invoices accounting.banktransactions accounting.contacts accounting.settings accounting.manualjournals projects files"
# Bump this string to force all admins to re-grant Xero scopes after the
# scope list changes. Any non-empty value works.
XERO_REAUTH_VERSION="initial"

# ---------------------------------------------------------------------------
# Public geocoding key (browser-exposed — see NEXT_PUBLIC_ prefix)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GEOAPIFY_API_KEY=""

# ---------------------------------------------------------------------------
# AI provider (OCR receipt analysis). Choose one and set AI_PROVIDER.
# ---------------------------------------------------------------------------
GROQ_API_KEY=""
GEMINI_API_KEY=""
AI_PROVIDER="groq"

# ---------------------------------------------------------------------------
# Redis cache. Optional — when unset, cache becomes a pass-through.
# ---------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379/1"
REDIS_KEY_PREFIX="dev:altomatehr"

# ---------------------------------------------------------------------------
# Shared secret for /api/cron/* endpoints. Generate with:
#   openssl rand -hex 32
# cPanel cron job must send: Authorization: Bearer $CRON_SECRET
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Sentry error monitoring. All four are optional — when DSN is unset, the
# Sentry SDK no-ops and the app behaves as if it isn't installed.
#
# DSN is split into NEXT_PUBLIC_ (browser bundle) and the unprefixed
# server variant. They can point at the same project.
#
# AUTH_TOKEN is only needed at build time for source-map upload (so
# production stack traces are readable). Generate at:
#   https://sentry.io/settings/account/api/auth-tokens/
# Scope it to "project:releases" + "project:write" for the project below.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
