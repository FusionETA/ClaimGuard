generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                              String                 @id @default(cuid())
  /// Email is NO LONGER unique at the DB level — an archived employee
  /// can come back later under the same address (in a different org,
  /// or as a fresh row after their old PayrollProfile was archived).
  /// The "at most one ACTIVE user per email" rule is enforced in the
  /// service layer (`lib/auth/email-uniqueness.ts`) on every create /
  /// update path. The index here keeps email lookups fast for login
  /// and the validator's existence check.
  email                           String
  name                            String
  role                            UserRole
  organizationId                  String?
  passwordHash                    String
  avatarUrl                       String?
  createdAt                       DateTime               @default(now())
  updatedAt                       DateTime               @updatedAt
  passwordChangedAt               DateTime?
  adminOrganizations              AdminOrganization[]    @relation("AdminOrganizations")
  approvalChainApprovals          ApprovalChainStep[]    @relation("ApproverChain")
  approvalChainSteps              ApprovalChainStep[]    @relation("EmployeeChain")
  approvals                       ApprovalRequest[]      @relation("EmployeeApprovals")
  approvalReviews                 ApprovalRequest[]      @relation("ReviewerApprovals")
  attendanceEdits                 AttendanceEditLog[]    @relation("AttendanceEditLogActor")
  attendance                      AttendanceRecord[]     @relation("EmployeeAttendance")
  breakSessionEdits               BreakSessionEditLog[]  @relation("BreakSessionEditLogActor")
  claims                          Claim[]                @relation("EmployeeClaims")
  reviews                         Claim[]                @relation("AdminReviews")
  claimApprovalEntries            ClaimApprovalEntry[]   @relation("UserApprovalEntries")
  employeeImportDrafts            EmployeeImportDraft[]
  employeeProfile                 EmployeeProfile?       @relation("EmployeeProfileUser")
  notifications                   Notification[]
  auditLogActor                   OrganizationAuditLog[] @relation("OrgAuditLogActor")
  submittedPayrollRuns            PayrollRun[]           @relation("PayrollRunSubmittedBy")
  submittedForApprovalPayrollRuns PayrollRun[]           @relation("PayrollRunSubmittedForApprovalBy")
  projectManagerOf                ProjectManager[]       @relation("ProjectManagerOf")
  pushSubscriptions               PushSubscription[]
  salaryChangesAuthored           SalaryChange[]         @relation("salaryChangeAuthor")
  organization                    Organization?          @relation(fields: [organizationId], references: [id])
  xeroConnections                 XeroConnection[]       @relation("XeroConnectedBy")
  managedProjects                 XeroProject[]          @relation("ProjectManager")

  @@index([organizationId])
  @@index([email])
}

model Organization {
  id                        String                    @id @default(cuid())
  name                      String                    @unique
  claimCutoffDay            Int                       @default(25)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  /// Subscription plan provisioned by the partner API.
  /// DIY = self-service customer; EXPERT = we manage their account.
  /// Defaults to DIY for legacy orgs that pre-date plan tracking.
  plan                      OrgPlan                   @default(DIY)
  /// FREE | PAID only when plan = DIY. Null for EXPERT (no tier split).
  tier                      OrgPlanTier?
  /// JSON string[] of feature addons. Today: ["expense_claim", "clock"].
  /// Drives org-level navigation gating — admins + employees only see
  /// Claims when "expense_claim" is in this list AND the plan is paid
  /// (or expert). Drives the deriveOrgEnabledModules helper.
  addons                    Json?
  workingHoursEnd           String                    @default("18:00")
  workingHoursStart         String                    @default("09:00")
  geofenceRadiusMeters      Int                       @default(200)
  defaultMileageRate        Decimal?                  @db.Decimal(10, 4)
  mileageUnit               MileageUnit               @default(KM)
  otEnabled                 Boolean                   @default(true)
  timezone                  String                    @default("Asia/Kuala_Lumpur")
  /// JSON array of ISO 4217 currency codes the admin has enabled for
  /// expense claims (e.g. ["MYR","USD","SGD"]). Empty/null falls back to
  /// just defaultCurrency. The employee claim form picker shows only
  /// these codes.
  allowedCurrencies         Json?
  /// Default currency for new claims when the AI can't detect one and
  /// the user hasn't picked. ISO 4217 code. Replaces the previous
  /// hardcoded "USD". Null until the admin sets it (in which case the
  /// claim service falls back to "MYR" for backwards-safety).
  defaultCurrency           String?
  /// When true, the admin attendance Trends tab renders the supervisor
  /// performance card listing supervisors with slow approvals (any
  /// decision exceeding `supervisorSlaMinutes`) and any rejections.
  supervisorReportEnabled   Boolean                   @default(true)
  /// SLA threshold (in minutes) used to flag a supervisor approval as
  /// "slow" in the supervisor performance card. Defaults to 60.
  supervisorSlaMinutes      Int                       @default(60)
  /// When true, employees can apply for leave that hasn't yet accrued
  /// — provided it WILL have accrued by the leave's start date (e.g.
  /// in January book 6 days for June against a PRO_RATED entitlement
  /// that monthly-accrues to 6 by then). When false (default), the
  /// strict rule applies: requested days must fit within today's
  /// balance. Only affects PRO_RATED leave types; LUMP_SUM is fully
  /// credited at the start of the year so forecasting is a no-op.
  allowForecastedLeaveApply Boolean                   @default(false)
  adminMembers              AdminOrganization[]
  apiIntegrations           ApiIntegration[]
  chartAccounts             ChartOfAccount[]
  claims                    Claim[]
  employeeImportDrafts      EmployeeImportDraft[]
  employeePolicies          EmployeePolicy[]
  leaveTypes                LeaveType[]
  auditLog                  OrganizationAuditLog[]
  payrollAnnualReports      PayrollAnnualReport[]
  payrollCompanyInfo        PayrollCompanyInfo?
  payrollPortalCredentials  PayrollPortalCredential[]
  payrollRuns               PayrollRun[]
  payrollSettings           PayrollSettings?
  users                     User[]
  xeroConnection            XeroConnection?
  projects                  XeroProject[]
}

/// Admin-defined classification for an employee. Replaces the previous
/// hardcoded "Hourly Worker" / "Office Worker" pair. An organization can
/// have any number of policies. Each EmployeeProfile is assigned to one
/// policy via `policyId`. The policy controls:
/// - which employee modules are visible (Attendance / Claims / Leave)
/// - salary type (HOURLY vs MONTHLY)
/// - OT method (CASH vs TIME_BANK)
/// Two policies are seeded per org during the migration so existing
/// behavior is preserved at cutover.
model EmployeePolicy {
  id                          String                   @id @default(cuid())
  organizationId              String
  name                        String
  description                 String?
  /// Exactly one policy per org should be the default (used when creating
  /// a new employee through the admin UI / API without specifying one).
  isDefault                   Boolean                  @default(false)
  /// Soft-archive. Archived policies are hidden from new assignments but
  /// kept around so historical employee snapshots stay readable.
  archivedAt                  DateTime?
  canAccessAttendance         Boolean                  @default(true)
  canAccessClaims             Boolean                  @default(true)
  canAccessLeave              Boolean                  @default(true)
  salaryType                  PayoutMethod             @default(HOURLY)
  otMethod                    OtPayoutMethod           @default(CASH)
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  /// When false, employees on this policy cannot file OT at all — the
  /// OT method below is ignored and OT-related UI is hidden.
  otEnabled                   Boolean                  @default(true)
  /// When true, employees on this policy must be inside the project
  /// geofence (radius set on Organization, lat/lng on Project) to clock
  /// in. When false, geofence checks are skipped for these employees.
  requireGeofence             Boolean                  @default(true)
  /// When true, the clock-in flow gates on a selfie capture. Replaces
  /// the legacy `salaryType === HOURLY` heuristic — admins can now turn
  /// selfie on for any policy regardless of pay type.
  requireSelfie               Boolean                  @default(false)
  /// Daily working minutes after which extra time becomes OT-eligible.
  /// Stored as minutes for precision; the admin UI presents this as
  /// hours (minutes ÷ 60).
  otDailyThresholdMinutes     Int                      @default(480)
  /// OT multipliers (× HRP) — applied only when otMethod === CASH.
  /// Ignored for TIME_BANK (banks 1:1) and when otEnabled = false.
  /// Values are kept in the row when OT mode is non-CASH so toggling
  /// back to CASH restores the admin's chosen rates.
  otRateNormalDay             Decimal                  @default(1.50) @db.Decimal(4, 2)
  otRatePublicHoliday         Decimal                  @default(3.00) @db.Decimal(4, 2)
  otRatePublicHolidayInShift  Decimal                  @default(2.00) @db.Decimal(4, 2)
  otRateRestDay               Decimal                  @default(2.00) @db.Decimal(4, 2)
  /// In-shift premiums (× ORP) for hours worked within the regular
  /// shift on rest days / public holidays.
  otRateRestDayInShift        Decimal                  @default(1.00) @db.Decimal(4, 2)
  /// Optional monthly-salary cap above which OT requires extra approval.
  /// Null means no cap. Mirrors the legacy org-wide
  /// `Organization.otSalaryThreshold` but is now opt-in per policy.
  otSalaryThreshold           Decimal?                 @db.Decimal(10, 2)
  /// When true, employees on this policy are temporary (e.g. probation,
  /// fixed-term). The admin sets a `temporaryReviewDate` on each such
  /// employee's payroll profile; a cron reminds admins to revisit the
  /// employee's classification when that date arrives.
  temporary                   Boolean                  @default(false)
  captureLocationOnBreakEnd   Boolean                  @default(true)
  captureLocationOnBreakStart Boolean                  @default(true)
  /// Per-event capture flags. Only consulted when geolocationEnabled
  /// is true. Default true so newly-created policies record location
  /// for every event out of the box.
  captureLocationOnClockIn    Boolean                  @default(true)
  captureLocationOnClockOut   Boolean                  @default(true)
  /// Master switch for capturing the employee's GPS coordinates on
  /// clock events. When false, the client never asks for GPS and the
  /// per-event capture flags below are ignored. When true, the four
  /// per-event flags decide which events get their coords persisted.
  /// Auto-flipped to true on the server when `requireGeofence` is
  /// turned on (geofence enforcement needs GPS to work).
  geolocationEnabled          Boolean                  @default(true)
  organization                Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees                   EmployeeProfile[]
  leaveDefaults               PolicyLeaveEntitlement[]

  @@unique([organizationId, name])
  @@index([organizationId, isDefault])
}

/// External-system API tokens. Each row is a tenant's bearer credential
/// for calling /api/v1 routes. Tokens are stored only as bcrypt-style
/// hashes — the raw token is shown once on creation and never again.
///
/// Each token is permanently scoped to a single Organization, so server
/// logic can resolve `orgId` from the token alone — clients never pass
/// it. Permissions are gated by `scopes` (a JSON string array such as
/// ["employees:read","employees:write","claims:read"]).
model ApiIntegration {
  id                  String        @id @default(cuid())
  name                String
  tokenHash           String        @unique
  /// Short prefix of the raw token, kept in plaintext for UX so the admin
  /// can identify a token in the list ("wp_live_********abcd"). Never the
  /// full token.
  tokenPrefix         String
  organizationId      String
  /// Stored as a JSON string array. Mirrors the curated scope set in
  /// `lib/api-auth.ts`. Empty array means the token can authenticate but
  /// not access any resource — admin must add scopes to enable it.
  scopes              Json
  active              Boolean       @default(true)
  createdAt           DateTime      @default(now())
  lastUsedAt          DateTime?
  /// When non-null, this integration was auto-issued by a partner via
  /// `POST /api/v1/admin/organizations` (see MasterApiKey). Null when
  /// the admin created the token manually through Settings → API.
  issuedByMasterKeyId String?
  auditLogs           ApiAuditLog[]
  issuedByMasterKey   MasterApiKey? @relation(fields: [issuedByMasterKeyId], references: [id])
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([tokenHash])
  @@index([issuedByMasterKeyId])
}

/// Audit trail for /api/v1 requests. One row per request, written after
/// auth resolves (so unauthenticated requests don't pollute the log).
/// Retained for forensic/compliance review; the admin's API tab can
/// surface a recent slice of this.
model ApiAuditLog {
  id            String         @id @default(cuid())
  integrationId String
  method        String
  path          String         @db.VarChar(500)
  statusCode    Int
  /// IP of the caller from x-forwarded-for or request remote address.
  /// Stored as text because IPv6 + proxy chains make a fixed type
  /// inconvenient.
  ip            String?        @db.VarChar(64)
  /// Compact summary if the request errored. Successful requests leave
  /// this null.
  errorMessage  String?        @db.Text
  createdAt     DateTime       @default(now())
  integration   ApiIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
  @@index([createdAt])
}

/// Partner-level "platform" credential. One row per integration partner
/// (e.g. Acme HR portal). The partner uses this to call the
/// /api/v1/admin/* endpoints — most importantly to provision a new
/// AltomateHR Organization on behalf of one of THEIR end-customers, which
/// returns a per-org `ApiIntegration` token in the response.
///
/// Master keys never call /api/v1/<resource> directly — those routes
/// always require a per-org token. This separation means a leaked master
/// key cannot read any tenant's data: it can only create new tenants.
///
/// Token format: `wp_master_<64 hex chars>`. Stored as SHA-256 hash.
model MasterApiKey {
  id                 String              @id @default(cuid())
  partnerName        String
  tokenHash          String              @unique
  tokenPrefix        String
  active             Boolean             @default(true)
  /// Optional internal notes — contract id, contact email, etc. Never
  /// surfaced to the partner.
  notes              String?             @db.Text
  createdAt          DateTime            @default(now())
  lastUsedAt         DateTime?
  issuedIntegrations ApiIntegration[]
  auditLogs          MasterApiAuditLog[]

  @@index([tokenHash])
}

/// Audit trail for /api/v1/admin/* requests authenticated by a master
/// key. Kept separate from `ApiAuditLog` because those rows are scoped
/// to a specific Organization/integration; master-key calls aren't (the
/// org may not exist yet).
model MasterApiAuditLog {
  id                    String       @id @default(cuid())
  masterKeyId           String
  method                String
  path                  String       @db.VarChar(500)
  statusCode            Int
  ip                    String?      @db.VarChar(64)
  /// When the call successfully provisioned a new organization, this is
  /// set to the new org's id so the audit log can link back to the
  /// tenant the master key created.
  createdOrganizationId String?
  errorMessage          String?      @db.Text
  createdAt             DateTime     @default(now())
  masterKey             MasterApiKey @relation(fields: [masterKeyId], references: [id], onDelete: Cascade)

  @@index([masterKeyId, createdAt])
  @@index([createdAt])
}

model AdminOrganization {
  id             String       @id @default(cuid())
  adminId        String
  organizationId String
  createdAt      DateTime     @default(now())
  /// JSON array of admin module keys the admin can access in this org
  /// (e.g. ["claims_personal","payroll","leave"]). `null` = full access
  /// (legacy behaviour for admins added before this column shipped — they
  /// keep equal-tier access until the owner edits it). Empty array = no
  /// modules visible (rare; effectively locked out).
  /// Source enum lives in `components/admin/admin-access-picker.tsx`
  /// (`ADMIN_MODULES`) until we promote it to a Prisma enum.
  modules        Json?
  /// JSON array of EmployeePolicy ids the admin can manage in this org.
  /// `null` = all policies. Empty array = no policies. Used by claims /
  /// leave / attendance / payroll preview to filter the employees this
  /// admin can see.
  policyIds      Json?
  updatedAt      DateTime     @default(now()) @updatedAt
  admin          User         @relation("AdminOrganizations", fields: [adminId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([adminId, organizationId])
  @@index([adminId])
  @@index([organizationId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Persisted in-app notification. Mirrors what gets sent via web push so
/// users have a notification center (bell + list) on both the admin and
/// employee surfaces. Created through the notification service alongside
/// the push send, so a user sees the same event whether or not push was
/// delivered.
model Notification {
  id             String           @id @default(cuid())
  /// Recipient. A notification always targets exactly one user.
  userId         String
  /// Org the notification belongs to (for scoping/auditing). Nullable for
  /// the rare cross-org case; recipient is always the source of truth.
  organizationId String?
  type           NotificationType
  title          String
  body           String           @db.Text
  /// Relative URL to open when clicked, e.g. "/employee/claims". Mirrors
  /// the web-push payload's `url`.
  url            String?          @db.VarChar(500)
  /// Null while unread; set to the read timestamp once acknowledged.
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Resumable draft of the bulk-employee-import wizard. One draft per
/// (user, organization). Auto-saved by the wizard on every state
/// change (debounced), restored when the admin re-opens the dialog.
///
/// `state` is the full client-side wizard state as JSON — CSV text,
/// AI mapping suggestions, admin-confirmed column / value mappings,
/// per-row overrides, current step, etc. Stored as `LongText` so the
/// 5 MB CSV upload cap fits comfortably.
///
/// Drafts older than 7 days are purged on each `getDraftForUser` call
/// so stale drafts never bother an admin who's moved on.
model EmployeeImportDraft {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  /// Original uploaded file name (best-effort display only).
  fileName       String?
  /// The wizard step the admin was on when last saved. One of
  /// "upload" | "map" | "values" | "preview" | "done". Stored as a
  /// loose string so adding a step doesn't require a migration.
  step           String
  /// Row count from the most recent preview/normalisation. Surfaced
  /// in the "Continue draft" panel so admins can recognise their draft
  /// at a glance.
  rowCount       Int          @default(0)
  /// Full wizard state as JSON. See the wizard component for the
  /// serialised shape — fields are optional and the loader is
  /// tolerant of partial blobs so older drafts survive code changes.
  state          Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([updatedAt])
  @@index([organizationId], map: "EmployeeImportDraft_organizationId_fkey")
}

model EmployeeProfile {
  id                    String                      @id @default(cuid())
  userId                String                      @unique
  employeeId            String
  jobTitle              String
  preferredCurrency     String                      @default("USD")
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  /// Cumulative banked OT minutes for TIME_BANK Office Workers.
  otTimeBalanceMin      Int                         @default(0)
  /// Employee policy assignment. Drives module visibility and is the
  /// admin-facing source of truth for salary type + OT method.
  policyId              String?
  loans                 EmployeeLoan[]
  policy                EmployeePolicy?             @relation(fields: [policyId], references: [id])
  user                  User                        @relation("EmployeeProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  projectAssignments    EmployeeProjectAssignment[]
  teamMemberships       EmployeeTeamMembership[]
  leaveApplications     LeaveApplication[]
  leaveEntitlements     LeaveEntitlement[]
  payrollProfile        PayrollProfile?
  payrollRunAdjustments PayrollRunAdjustment[]
  payrollRunClaims      PayrollRunClaim[]
  payslips              Payslip[]
  salaryChanges         SalaryChange[]

  @@index([policyId])
  @@index([employeeId])
}

model EmployeeProjectAssignment {
  id                String          @id @default(cuid())
  employeeProfileId String
  projectId         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  project           XeroProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, projectId])
  @@index([employeeProfileId])
  @@index([projectId])
}

model Claim {
  id                        String                      @id @default(cuid())
  claimNumber               String                      @unique
  title                     String
  description               String                      @db.Text
  category                  ClaimCategory
  organizationId            String?
  chartOfAccountId          String?
  amount                    Decimal                     @db.Decimal(12, 2)
  currency                  String                      @default("USD")
  spentAt                   DateTime
  submittedAt               DateTime                    @default(now())
  claimRunMonth             DateTime?
  /// Latest review timestamp. The column gets overwritten on each
  /// supervisor decision and finally on admin review — it's a "last
  /// seen by reviewer" snapshot, not a per-step audit. The full
  /// per-step history lives in `ClaimApprovalEntry`.
  lastReviewedAt            DateTime?                   @map("reviewedAt")
  status                    ClaimStatus                 @default(PENDING)
  receiptUrl                String?
  reviewNotes               String?                     @db.Text
  employeeId                String
  /// Latest reviewer's user id (overwritten on each step). For per-step
  /// "who acted at step N" use `ClaimApprovalEntry`.
  lastReviewerId            String?                     @map("reviewerId")
  xeroBillId                String?                     @unique
  xeroBillRef               String?
  xeroSyncStatus            XeroSyncStatus              @default(NOT_SYNCED)
  xeroSyncError             String?                     @db.Text
  xeroSyncedAt              DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  payViaAccountId           String?
  paymentType               PaymentType                 @default(PERSONAL)
  claimType                 ClaimType                   @default(EXPENSE)
  distance                  Decimal?                    @db.Decimal(10, 2)
  mileageDestinationAddress String?
  mileageOriginAddress      String?
  mileageRateUsed           Decimal?                    @db.Decimal(10, 4)
  mileageUnitUsed           MileageUnit?
  reviewerRole              Claim_reviewerRole?
  /// Project this claim is filed against. Drives approval routing — when
  /// set, the claim follows the employee's team chain in this project.
  /// Nullable for legacy claims that pre-date the project picker; new
  /// submissions require it whenever the employee has any project
  /// assignments.
  projectId                 String?
  /// True when the claim's amount blew past the chart-of-account spend
  /// limit at submission time. The claim is still saved (employees can
  /// submit over-limit), but admins see a visual flag in their queue.
  exceedsLimit              Boolean                     @default(false)
  /// Xero Files API file id. Set when the receipt was uploaded to Xero
  /// Files (i.e. the claim's chart-of-account is connected to a Xero
  /// tenant). Null for receipts kept on local disk.
  xeroFileId                String?
  /// Optional free-text "who you spent the money with" — typically a
  /// client or vendor name (e.g. "ABC Client Sdn Bhd"). Surfaced on
  /// the review screens for admins/supervisors and can be used as a
  /// secondary search term. Nullable because legacy claims and
  /// reasonable categories (own-use office supplies) don't need it.
  spendingWith              String?
  /// For COMPANY-money claims synced to Xero as a "Spend Money" bank
  /// transaction (money already left the company bank/card), as opposed
  /// to PERSONAL claims which post as an awaiting-payment bill
  /// (`xeroBillId`). Set once on sync so the post is idempotent. Unique
  /// to prevent a double-post creating two transactions for one claim.
  xeroSpendMoneyId          String?                     @unique
  xeroSpendMoneyRef         String?
  /// Free-text "where you spent" — the merchant / vendor / restaurant
  /// name from the receipt (e.g. "Starbucks KLCC", "Office Depot",
  /// "Acme Hardware Sdn Bhd"). Distinct from `spendingWith` (the
  /// counterparty — e.g. a client you ate with). For COMPANY-money
  /// claims this is REQUIRED at submission and becomes the Xero Spend
  /// Money Contact ("Bill To"). For PERSONAL claims it's optional
  /// context for the approver. Nullable so legacy claims that pre-date
  /// the field can still be loaded + resynced without backfill.
  spendingAt                String?
  chartOfAccount            ChartOfAccount?             @relation("ClaimAccount", fields: [chartOfAccountId], references: [id])
  employee                  User                        @relation("EmployeeClaims", fields: [employeeId], references: [id], onDelete: Cascade)
  organization              Organization?               @relation(fields: [organizationId], references: [id])
  payViaAccount             ChartOfAccount?             @relation("ClaimPayViaAccount", fields: [payViaAccountId], references: [id])
  project                   XeroProject?                @relation("ClaimProject", fields: [projectId], references: [id])
  reviewer                  User?                       @relation("AdminReviews", fields: [lastReviewerId], references: [id])
  approvalEntries           ClaimApprovalEntry[]
  supportingAttachments     ClaimSupportingAttachment[]
  payrollRunAttachment      PayrollRunClaim?
  payslipLineItem           PayslipLineItem?

  @@index([organizationId, submittedAt])
  @@index([chartOfAccountId])
  @@index([employeeId, submittedAt])
  @@index([payViaAccountId], map: "Claim_payViaAccountId_fkey")
  @@index([status, submittedAt])
  @@index([xeroSyncStatus])
  @@index([lastReviewerId], map: "Claim_reviewerId_fkey")
  @@index([projectId])
}

/// Optional extra files attached to a claim alongside the primary
/// OCR-scanned receipt. Used for supporting documents — quotations,
/// invoices, approval emails, screenshots, secondary receipts. The
/// primary receipt stays on `Claim.receiptUrl` + `Claim.xeroFileId`;
/// only EXTRA files live here.
///
/// All supporting files travel to Xero alongside the main receipt
/// when the claim's COA is Xero-linked — they're uploaded to Xero
/// Files API and associated with the same Bill on claim approval.
model ClaimSupportingAttachment {
  id         String   @id @default(cuid())
  claimId    String
  /// Original filename the user chose. Display only — actual storage
  /// is at `fileUrl` (or via Xero Files when `xeroFileId` is set).
  fileName   String
  /// Local file URL when stored on disk; null when only Xero Files
  /// holds the bytes.
  fileUrl    String?
  /// Xero Files file id when the supporting doc was uploaded to Xero.
  /// Null for files kept on local disk (e.g. legacy claims or claims
  /// whose COA isn't Xero-linked).
  xeroFileId String?
  mimeType   String?
  /// File size in bytes. Used for the UI's per-file pill (e.g.
  /// "234 KB"). Null when unknown.
  sizeBytes  Int?
  createdAt  DateTime @default(now())
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

/// Per-step approval / rejection history for a claim. Inserted by the
/// supervisor review path each time someone in the chain acts. Lets the
/// UI accurately render which specific approver clicked Approve at each
/// step (vs. peers who didn't act, vs. the latest-only `Claim.reviewerId`
/// snapshot which gets overwritten).
///
/// Notes:
/// - `stepNumber` matches the chain template's step number — multi-
/// approver-per-step still produces ONE entry (the actor); the
/// unique constraint allows different approvers in the same step,
/// but the supervisor path only writes one when the step is satisfied.
/// - The admin's final review is NOT logged here; it's shown
/// separately as the REVIEWED badge on the claim summary.
model ClaimApprovalEntry {
  id          String                @id @default(cuid())
  claimId     String
  stepNumber  Int
  approverId  String
  decision    ClaimApprovalDecision
  reviewedAt  DateTime              @default(now())
  reviewNotes String?               @db.Text
  createdAt   DateTime              @default(now())
  approver    User                  @relation("UserApprovalEntries", fields: [approverId], references: [id])
  claim       Claim                 @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([claimId, stepNumber, approverId])
  @@index([claimId])
  @@index([approverId])
}

model ChartOfAccount {
  id                    String       @id @default(cuid())
  organizationId        String
  xeroAccountId         String?
  code                  String
  name                  String
  type                  String?
  status                String?
  isSelectable          Boolean      @default(false)
  isCustom              Boolean      @default(false)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  isBankAccount         Boolean      @default(false)
  isDisabled            Boolean      @default(false)
  allowMileageClaim     Boolean      @default(false)
  limitAmount           Decimal?     @db.Decimal(12, 2)
  limitPeriod           LimitPeriod?
  limitScope            LimitScope?
  mileageRate           Decimal?     @db.Decimal(10, 4)
  archivedByXeroConnect Boolean      @default(false)
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claims                Claim[]      @relation("ClaimAccount")
  paidClaims            Claim[]      @relation("ClaimPayViaAccount")

  @@unique([organizationId, xeroAccountId])
  @@unique([organizationId, code])
  @@index([organizationId, isSelectable])
  @@index([organizationId, isBankAccount])
}

model XeroConnection {
  id                       String       @id @default(cuid())
  provider                 String       @default("xero")
  organizationId           String       @unique
  tenantId                 String       @unique
  tenantName               String
  tenantType               String?
  accessToken              String       @db.Text
  refreshToken             String       @db.Text
  scope                    String       @db.Text
  tokenType                String
  accessTokenExpiresAt     DateTime
  connectedByAdminId       String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  /// Records the most recent value of XERO_REAUTH_VERSION env var that the
  /// admin completed an OAuth flow against. When the env var is bumped (e.g.
  /// scopes expanded), connections whose lastReauthVersion no longer matches
  /// trigger the "Update permissions" button in the admin UI. Null = never
  /// re-auth'd (or env var was unset at the time of original connect).
  lastReauthVersion        String?
  /// Which Xero Tracking Category drives the "Projects" list on our side.
  /// Picked by the admin from the org's active tracking categories. Null
  /// when the admin hasn't picked one yet — projects sync stays no-op
  /// until they do. Cached name is for display in the settings UI so we
  /// don't have to round-trip Xero on every settings page load.
  xeroTrackingCategoryId   String?
  xeroTrackingCategoryName String?
  /// Wall-clock timestamp of the most recent successful OAuth flow against
  /// this connection. Distinct from `updatedAt` because silent token
  /// refreshes also bump `updatedAt`, which would make this read as "last
  /// connected at" when really only a background refresh happened. Null on
  /// rows that pre-date this column — UI falls back to `createdAt` in that
  /// case.
  reauthorizedAt           DateTime?
  /// Xero's own "connection ID" — returned by GET /connections, required
  /// by DELETE /connections/{id} to actually revoke the OAuth grant on
  /// Xero's side. `tenantId` is the org's ID in Xero and is NOT
  /// interchangeable with this — passing tenantId to the delete endpoint
  /// silently 404s and leaves the app stuck in the user's "Connected
  /// apps" list. Nullable for legacy rows created before this column
  /// existed; those rows fall back to a runtime GET /connections lookup
  /// the first time disconnect runs.
  xeroConnectionId         String?
  connectedByAdmin         User?        @relation("XeroConnectedBy", fields: [connectedByAdminId], references: [id])
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([provider])
  @@index([connectedByAdminId])
}

model XeroProject {
  id                     String                      @id @default(cuid())
  organizationId         String
  /// Legacy: populated for rows synced from the old `/Projects` API
  /// before we switched to tracking categories. Kept for back-compat
  /// so existing claims/attendance FKs keep working. New rows from
  /// the tracking-category sync use `xeroTrackingOptionId` instead.
  xeroProjectId          String?
  name                   String
  status                 String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  isManual               Boolean                     @default(false)
  location               String?
  projectManagerId       String?
  isDisabled             Boolean                     @default(false)
  latitude               Float?
  longitude              Float?
  workingHoursStart      String?
  workingHoursEnd        String?
  workingDays            String?
  /// Daily lunch break minutes deducted from the (end-start) span when
  /// computing expected daily working minutes. Defaults to 60.
  lunchBreakMinutes      Int                         @default(60)
  /// Populated for rows synced from a Xero Tracking Category option.
  /// Coexists with `xeroProjectId` on the same model so legacy rows
  /// and new tracking-option rows live side-by-side. See
  /// `xeroTrackingCategoryId` (below) for which category this option
  /// belongs to — populated alongside `xeroTrackingOptionId` from the
  /// connection's active category at sync time.
  xeroTrackingOptionId   String?
  archivedByXeroConnect  Boolean                     @default(false)
  /// Snapshot of the Xero Tracking Category this row was synced under.
  /// Lets project listings scope by the connection's CURRENT active
  /// category so swapping categories hides stale rows from the picker
  /// (without deleting them — round-tripping back restores them with
  /// their managers, lat/long, etc. intact). Null for manual rows and
  /// legacy `/Projects`-API rows, which are always visible.
  xeroTrackingCategoryId String?
  attendanceRecords      AttendanceRecord[]          @relation("AttendanceRecordProject")
  claims                 Claim[]                     @relation("ClaimProject")
  assignedEmployees      EmployeeProjectAssignment[]
  holidays               ProjectHoliday[]
  projectManagers        ProjectManager[]            @relation("ProjectManagers")
  teams                  Team[]
  organization           Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectManager         User?                       @relation("ProjectManager", fields: [projectManagerId], references: [id])

  @@unique([organizationId, xeroProjectId])
  @@unique([organizationId, xeroTrackingOptionId])
  @@index([organizationId, name])
  @@index([organizationId, xeroTrackingCategoryId])
  @@index([projectManagerId])
}

model ProjectHoliday {
  id        String      @id @default(cuid())
  projectId String
  date      DateTime    @db.Date
  name      String
  createdAt DateTime    @default(now())
  project   XeroProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
  @@index([projectId])
}

/// Many-to-many between XeroProject and User for project managers. Replaces
/// the legacy single XeroProject.projectManagerId column (which is kept
/// during migration but no longer the source of truth).
model ProjectManager {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime    @default(now())
  project   XeroProject @relation("ProjectManagers", fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation("ProjectManagerOf", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model AttendanceRecord {
  id                     String                @id @default(cuid())
  employeeId             String
  date                   DateTime
  timeIn                 DateTime?
  timeOut                DateTime?
  durationMin            Int?
  lateByMin              Int?
  location               String?
  project                String?
  status                 AttendanceStatus      @default(MISSING)
  /// System-captured context for the day — off-site warnings prepended
  /// during clock-in/out, etc. Not directly editable by the employee
  /// (those edits go to `remark` instead). Shown to supervisors in the
  /// team detail view.
  notes                  String?               @db.Text
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  projectId              String?
  /// When the file was uploaded to Xero. Independent from timeIn so
  /// re-clocks (re-upload) reset the retention window.
  selfieUploadedAt       DateTime?
  /// Xero Files API file ID for the clock-in selfie. Null when no
  /// selfie was captured (Office Workers, or upload failed). Cleared
  /// by the prune cron after the retention window.
  xeroSelfieFileId       String?
  /// Employee's free-form remark about their shift. Set via the clock-
  /// out summary popup or the dashboard remark card. Kept separate from
  /// `notes` so off-site context never bleeds into the employee's own
  /// commentary (and vice-versa).
  remark                 String?               @db.Text
  clockInDistanceMeters  Float?
  /// Captured GPS coordinates and distance-from-site at clock-in. Null
  /// when the employee clocked in without granting location (Office
  /// Workers, web clients without geolocation, or pre-migration rows).
  /// `clockInDistanceMeters` is haversine distance to the project's
  /// geofence center at the moment of clock-in.
  clockInLat             Float?
  clockInLng             Float?
  clockOutDistanceMeters Float?
  clockOutLat            Float?
  clockOutLng            Float?
  editLogs               AttendanceEditLog[]
  employee               User                  @relation("EmployeeAttendance", fields: [employeeId], references: [id], onDelete: Cascade)
  projectRef             XeroProject?          @relation("AttendanceRecordProject", fields: [projectId], references: [id])
  sessions               AttendanceSession[]
  breaks                 BreakSession[]
  breakEditLogs          BreakSessionEditLog[]

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@index([status, date])
  @@index([projectId])
  @@index([selfieUploadedAt])
}

/// Audit trail of supervisor/admin/employee edits to AttendanceRecord
/// fields. One row per save action — captures before/after values for
/// timeIn, timeOut, status, notes, and remark so the change history is
/// fully reconstructable. `source` tags which UI path produced the edit.
model AttendanceEditLog {
  id                 String                       @id @default(cuid())
  attendanceRecordId String
  editedById         String
  /// Snapshot of the editor's role at the time of the edit so the trail
  /// stays meaningful even if the user's role changes later.
  editorRole         AttendanceEditLog_editorRole
  reason             String?                      @db.Text
  prevTimeIn         DateTime?
  nextTimeIn         DateTime?
  prevTimeOut        DateTime?
  nextTimeOut        DateTime?
  prevStatus         AttendanceStatus?
  nextStatus         AttendanceStatus?
  prevNotes          String?                      @db.Text
  nextNotes          String?                      @db.Text
  prevRemark         String?                      @db.Text
  nextRemark         String?                      @db.Text
  /// "DIRECT_EDIT" | "APPROVE_OVERRIDE" | "EMPLOYEE_REMARK" | "APPROVAL_REJECTION"
  source             String
  createdAt          DateTime                     @default(now())
  attendanceRecord   AttendanceRecord             @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  editor             User                         @relation("AttendanceEditLogActor", fields: [editedById], references: [id])

  @@index([attendanceRecordId, createdAt])
  @@index([editedById, createdAt])
}

model BreakSession {
  id                      String                @id @default(cuid())
  attendanceRecordId      String
  startedAt               DateTime
  endedAt                 DateTime?
  createdAt               DateTime              @default(now())
  endedAtDistanceMeters   Float?
  /// Same shape, captured at break-end.
  endedAtLat              Float?
  endedAtLng              Float?
  startedAtDistanceMeters Float?
  /// GPS coords captured at break-start, when the employee's policy
  /// allows location capture. Null when GPS wasn't available or the
  /// policy has it disabled. `distanceMeters` is the haversine distance
  /// from the project geofence center at capture time (display only;
  /// no enforcement on breaks).
  startedAtLat            Float?
  startedAtLng            Float?
  /// FK to the specific session this break belongs to. Null on legacy
  /// rows created before multi-session was introduced; a backfill script
  /// populates this for existing records.
  attendanceSessionId     String?
  attendanceRecord        AttendanceRecord      @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  attendanceSession       AttendanceSession?    @relation(fields: [attendanceSessionId], references: [id])
  editLogs                BreakSessionEditLog[]

  @@index([attendanceRecordId])
  @@index([attendanceRecordId, endedAt])
  @@index([attendanceSessionId])
}

/// One clock-in / clock-out pair per employee per day. Multiple sessions
/// may exist for the same AttendanceRecord when an employee clocks in,
/// clocks out, and clocks in again later on the same calendar day.
/// AttendanceRecord stays as the daily roll-up; sessions hold all the
/// per-event data (times, GPS, selfie, approval request links).
model AttendanceSession {
  id                        String           @id @default(cuid())
  attendanceRecordId        String
  startedAt                 DateTime
  endedAt                   DateTime?
  durationMin               Int?
  status                    AttendanceStatus @default(ON_TIME)
  clockInLat                Float?
  clockInLng                Float?
  clockInDistanceMeters     Float?
  clockOutLat               Float?
  clockOutLng               Float?
  clockOutDistanceMeters    Float?
  clockInNotes              String?
  clockOutNotes             String?
  /// Xero Files file ID for the selfie taken at this specific clock-in.
  /// Never overwritten by a second session on the same day.
  xeroSelfieFileId          String?
  selfieUploadedAt          DateTime?
  /// Project snapshotted at clock-in so admin changes mid-day don't
  /// retroactively rewrite which project this session was for.
  project                   String?
  projectId                 String?
  /// Approval request created at clock-in for this session.
  clockInApprovalRequestId  String?          @unique
  /// Approval request created at clock-out for this session.
  clockOutApprovalRequestId String?          @unique
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  attendanceRecord          AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  breaks                    BreakSession[]

  @@index([attendanceRecordId, startedAt])
  @@index([attendanceRecordId, endedAt])
}

/// Audit trail of supervisor/admin edits to BreakSession rows. One row
/// per save (or create/delete) — captures the before/after values of
/// `startedAt` and `endedAt`, plus the originating edit `source` tag.
model BreakSessionEditLog {
  id                 String                         @id @default(cuid())
  /// Nullable so deleted BreakSession rows survive cascade as historical
  /// audit; set to `null` via `SetNull` when the source row is removed.
  breakSessionId     String?
  /// Always set so we can query "all break edits on this day" even after
  /// the break row itself was deleted.
  attendanceRecordId String
  editedById         String
  editorRole         BreakSessionEditLog_editorRole
  reason             String?                        @db.Text
  /// `null` when this edit row represents a CREATE (no prior value).
  prevStartedAt      DateTime?
  /// `null` when this edit row represents a DELETE.
  nextStartedAt      DateTime?
  prevEndedAt        DateTime?
  nextEndedAt        DateTime?
  /// "DIRECT_EDIT" | "APPROVAL_REJECTION" | "CREATE" | "DELETE"
  source             String
  createdAt          DateTime                       @default(now())
  attendanceRecord   AttendanceRecord               @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  breakSession       BreakSession?                  @relation(fields: [breakSessionId], references: [id])
  editor             User                           @relation("BreakSessionEditLogActor", fields: [editedById], references: [id])

  @@index([attendanceRecordId, createdAt])
  @@index([breakSessionId, createdAt])
  @@index([editedById, createdAt])
}

model ApprovalRequest {
  id             String          @id @default(cuid())
  employeeId     String
  reviewerId     String?
  kind           ApprovalKind
  status         ApprovalStatus  @default(PENDING)
  date           DateTime
  eventAt        DateTime?
  title          String
  detail         String          @db.Text
  location       String?
  otSubtype      OTSubtype?
  lateMinutes    Int?
  offsetRef      String?
  reviewNotes    String?         @db.Text
  submittedAt    DateTime        @default(now())
  reviewedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  project        String?
  /// Per-step approval history. Array<{ step: number; approverId: string;
  /// approverName: string; reviewedAt: string; status: "APPROVED" |
  /// "REJECTED"; notes: string | null }>. Null for auto-approved requests
  /// and rows created before the multi-layer chain was introduced.
  chainHistory   Json?
  /// Snapshot of the employee's OT payout method at submission time.
  /// Locks payout treatment so a later profile change cannot rewrite
  /// already-submitted history. Null for non-OT requests.
  otPayoutMethod OtPayoutMethod?
  employee       User            @relation("EmployeeApprovals", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer       User?           @relation("ReviewerApprovals", fields: [reviewerId], references: [id])

  @@index([employeeId, date])
  @@index([status, date])
  @@index([kind, status])
  @@index([reviewerId], map: "ApprovalRequest_reviewerId_fkey")
}

model ApprovalChainStep {
  id         String   @id @default(cuid())
  employeeId String
  step       Int
  approverId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  /// teamId scopes this chain step to a specific team. An employee in
  /// multiple projects has one chain per team. Null only on legacy rows
  /// that pre-date the per-team migration; the backfill script fills these
  /// in from the employee's existing team membership.
  teamId     String?
  approver   User     @relation("ApproverChain", fields: [approverId], references: [id])
  employee   User     @relation("EmployeeChain", fields: [employeeId], references: [id], onDelete: Cascade)
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([employeeId, teamId, step, approverId])
  @@index([employeeId])
  @@index([approverId])
  @@index([teamId])
}

/// Team-based approval template attached to a XeroProject. Each team has a
/// fixed number of hierarchy layers and a per-module config that says which
/// layers must approve for each module (CLAIMS, OT, LEAVE, ATTENDANCE).
/// Employees join a team at a specific layer; their effective approval chain
/// for a given module is filtered by the team's moduleConfig.
model Team {
  id                        String                   @id @default(cuid())
  projectId                 String
  name                      String
  layerCount                Int                      @default(1)
  layerLabels               Json?
  moduleConfig              Json
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  requireBreakEndApproval   Boolean                  @default(true)
  requireBreakStartApproval Boolean                  @default(true)
  /// Per-event approval gates for attendance kinds. When false, the
  /// corresponding clock/break event auto-approves at creation time
  /// (no chain). When true, the event flows through the team's
  /// existing ATTENDANCE module chain (see `moduleConfig.ATTENDANCE`).
  /// Default true preserves the previous always-approve behaviour.
  /// BREAK is split here even though the underlying ApprovalKind stays
  /// "BREAK" — the request's `breakSubtype` ('start'/'end') decides
  /// which of these two flags applies.
  requireClockInApproval    Boolean                  @default(true)
  requireClockOutApproval   Boolean                  @default(true)
  chainSteps                ApprovalChainStep[]
  memberships               EmployeeTeamMembership[]
  project                   XeroProject              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

/// Joins an EmployeeProfile to a Team at a specific hierarchy layer (1-indexed,
/// must be <= team.layerCount). One row per (employee, team) — an employee
/// belongs to at most one layer per team.
model EmployeeTeamMembership {
  id                String          @id @default(cuid())
  employeeProfileId String
  teamId            String
  layer             Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  team              Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, teamId])
  @@index([teamId, layer])
}

/// One row per employee. Stores all Malaysia-payroll-specific data that
/// doesn't belong on `EmployeeProfile` (which is shared by claims +
/// attendance). Lazy-created when admin onboards the employee into
/// payroll — absence of a PayrollProfile = "employee not yet enrolled
/// in payroll." Cascade-deletes if the EmployeeProfile is deleted.
model PayrollProfile {
  id                       String          @id @default(cuid())
  employeeProfileId        String          @unique
  phone                    String?
  alternateEmail           String?
  gender                   Gender?
  dateOfBirth              DateTime?
  /// Free-text country/nationality string (e.g. "Malaysian",
  /// "Singaporean"). Drives the foreign-worker EPF branch — anything
  /// not "Malaysian" uses the foreign-worker rate.
  nationality              String?
  /// LHDN race code (M/C/I/O etc). Used for Form E reporting (deferred).
  race                     String?
  hasPr                    Boolean         @default(false)
  idType                   IdType?
  idNumber                 String?
  maritalStatus            MaritalStatus?
  isResident               Boolean         @default(true)
  /// OKU = disabled. Triggers DU (disabled individual) relief of
  /// RM 7,000 in the PCB calc.
  isOku                    Boolean         @default(false)
  spouseWorking            Boolean?
  spouseDisabled           Boolean?
  spousePcbNumber          String?
  spouseIdNumber           String?
  addressLine1             String?
  addressLine2             String?
  addressLine3             String?
  city                     String?
  postcode                 String?
  state                    String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  /// Dependent children — used for the PCB child relief (QC) calc.
  /// Stored as JSON to keep the row flat. Expected shape:
  /// [{ age: 12, abilityStatus: "NORMAL"|"DISABLED",
  /// currentlyStudying: "PRESCHOOL"|"PRIMARY"|"SECONDARY"|"HIGHER_ED"|"NONE",
  /// pcbDeduction: "FULL"|"HALF"|"NONE" }, ...]
  childRelief              Json?
  prevEmploymentYear       Int?
  /// Y — gross remuneration from previous employer in the same tax year.
  prevRemuneration         Decimal?        @db.Decimal(12, 2)
  /// K — total EPF contributed (employee share) by previous employer
  /// in the same tax year.
  prevEpf                  Decimal?        @db.Decimal(12, 2)
  contributeToEpf          Boolean         @default(true)
  /// Pre-1998 EPF members get different statutory rules. Captured for
  /// completeness; not used in v1 (defaults to false).
  epfMemberBefore1998      Boolean         @default(false)
  epfNumber                String?
  /// Employee's mandatory EPF rate %. Default 11% per current Malaysian
  /// law. Per-employee override of the org's defaultEpfEmployeeRate.
  epfEmployeeRate          Decimal         @default(11.00) @db.Decimal(5, 2)
  epfEmployeeVoluntary     Decimal         @default(0.00) @db.Decimal(5, 2)
  epfEmployerVoluntary     Decimal         @default(0.00) @db.Decimal(5, 2)
  socsoNumber              String?
  socsoScheme              SocsoScheme?
  contributeToEis          Boolean         @default(true)
  incomeTaxNumber          String?
  pcbBorneByEmployer       Boolean         @default(false)
  ssfwNumber               String?
  paymentMethod            PaymentMethod   @default(BANK_TRANSFER)
  bankName                 String?
  bankAccountHolderName    String?
  bankAccountNumber        String?
  salaryType               SalaryType
  /// Required when salaryType=MONTHLY. RM.
  monthlySalary            Decimal?        @db.Decimal(12, 2)
  /// Required when salaryType=HOURLY. RM per hour.
  hourlyRate               Decimal?        @db.Decimal(12, 2)
  /// Fixed adjustments applied to every payroll run.
  /// JSON shape: [{ category: "allowance_parking", name: "Parking Allowance", amount: 200 }, ...].
  /// One-off adjustments are added per-run via PayslipLineItem.
  fixedAllowances          Json?
  joinDate                 DateTime?
  /// Set when employee leaves. Triggers proration on their final
  /// payroll run.
  leaveDate                DateTime?
  archiveReason            String?
  /// True after the employee's final payroll has been reported to LHDN
  /// (Form E and friends). Excludes them from future runs even if not
  /// archived yet.
  reportedToLhdn           Boolean         @default(false)
  department               String?
  location                 String?
  workSchedule             String?
  payrollPolicy            String?
  payrollCycle             String?
  /// Leave entitlement — v2 placeholder for the leave module.
  /// Shape TBD when leave ships, e.g.
  /// [{ type: "ANNUAL", days: 14 }, { type: "SICK", days: 30 }]
  leaveEntitlement         Json?
  /// Archived profiles are excluded from new payroll runs but their
  /// historical payslips are retained.
  isArchived               Boolean         @default(false)
  archivedAt               DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  /// Uploaded payroll documents (contracts, offer letters, etc.).
  /// Stored as a JSON array of `PayrollDocument` records — see
  /// `modules/payroll/domain/models.ts`. Files themselves live in
  /// `public/uploads/payroll-documents/{userId}/` on disk.
  payrollDocuments         Json
  /// ΣLP — total allowable deductions (TP1 items: life insurance,
  /// medical, lifestyle, etc.) declared in the same tax year. Not
  /// yet consumed by the calc engine (TP1 collection is deferred),
  /// but captured here so future runs can pick it up without a
  /// migration.
  prevAllowableDeductions  Decimal?        @db.Decimal(12, 2)
  /// X — total MTD (PCB) actually paid by previous employer in the
  /// same tax year. Subtracted from annual tax inside `calcPcb` so
  /// mid-year joiners are not over-withheld until December.
  prevPcb                  Decimal?        @db.Decimal(12, 2)
  /// Z — total zakat already paid in the same tax year (via prior
  /// payroll or self-paid). Subtracted from annual tax inside
  /// `calcPcb` because zakat fully offsets MTD obligation.
  prevZakat                Decimal?        @db.Decimal(12, 2)
  /// Review/checkpoint date for temporary employees (probation end,
  /// fixed-term review, etc). Only meaningful when the assigned policy
  /// has `temporary = true`. A cron reminds admins when it arrives.
  temporaryReviewDate      DateTime?
  employeeProfile          EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  payslips                 Payslip[]
}

/// Audit-grade history of legitimate salary changes for an employee.
/// Created only when the admin explicitly classifies a salary edit
/// as a real compensation change (not a typo fix). Used for:
/// - LHDN / SOCSO / EIS audit responses
/// - Industrial Relations disputes
/// - Retrenchment / VSS payouts ("last drawn salary")
/// - HR year-end performance reviews
/// - Employer-issued salary-history letters (loans, EPF/income proof)
///
/// Does NOT drive the calc engine yet — the current `monthlySalary`
/// on `PayrollProfile` still determines every payroll run. The
/// `effectiveDate` field is here so a future Level 2 upgrade can
/// switch to effective-date aware salary resolution without a
/// migration.
model SalaryChange {
  id                    String             @id @default(cuid())
  employeeProfileId     String
  /// When the change takes effect. Defaults to today on the UI but the
  /// admin can backdate.
  effectiveDate         DateTime           @db.Date
  /// Snapshot of what the salary was BEFORE this change.
  previousSalaryType    SalaryType
  previousMonthlySalary Decimal?           @db.Decimal(12, 2)
  previousHourlyRate    Decimal?           @db.Decimal(12, 2)
  /// New values AFTER this change. Mirrors PayrollProfile columns.
  newSalaryType         SalaryType
  newMonthlySalary      Decimal?           @db.Decimal(12, 2)
  newHourlyRate         Decimal?           @db.Decimal(12, 2)
  reason                SalaryChangeReason
  notes                 String?            @db.Text
  /// User (admin) who made the change. Nullable to allow legacy /
  /// system-generated entries.
  changedByUserId       String?
  createdAt             DateTime           @default(now())
  changedByUser         User?              @relation("salaryChangeAuthor", fields: [changedByUserId], references: [id])
  employeeProfile       EmployeeProfile    @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([employeeProfileId, effectiveDate])
  @@index([changedByUserId], map: "SalaryChange_changedByUserId_fkey")
}

/// Per-org payroll rules. Frequently edited by admin (OT multipliers,
/// EPF defaults). Matches Altomate's `p_settings` table.
model PayrollSettings {
  id                        String          @id @default(cuid())
  organizationId            String          @unique
  workingDaysRule           WorkingDaysRule @default(TWENTY_SIX)
  defaultEpfEmployeeRate    Decimal         @default(11.00) @db.Decimal(5, 2)
  defaultEpfEmployerRate    Decimal         @default(13.00) @db.Decimal(5, 2)
  hrdfEnabled               Boolean         @default(false)
  hrdfRate                  Decimal?        @db.Decimal(5, 2)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  autoApplySocsoEisRelief   Boolean         @default(true)
  /// When true, submitting a payroll run posts the reimbursable claims
  /// attached to that run to Xero as "Awaiting Payment" bills. UI is
  /// gated behind an active Xero connection — see settings page.
  syncClaimsToXeroOnSubmit  Boolean         @default(false)
  /// When true, submitting a payroll run posts the payroll summary to
  /// Xero as a Manual Journal. Same Xero-connection UI gate.
  syncPayrollToXeroOnSubmit Boolean         @default(false)
  /// Xero sync mapping config — JSON blob shaped like
  /// `PayrollXeroMapping` (see `modules/payroll/domain/settings.ts`):
  /// - `aggregationMode`: "PER_EMPLOYEE" | "SUM_BY_PROJECT" — only
  /// affects expense-side debit lines on the manual journal;
  /// accruals are always summed.
  /// - `trackingCategoryId`: Xero tracking category to use for the
  /// "project" dimension on every line (bills + journals).
  /// - `accounts`: map of payroll-category → Xero account ID
  /// (salary, allowance, directorSalary, directorFee,
  /// epfEmployer, socsoEmployer, eisEmployer, hrdfEmployer,
  /// accrualEpf, accrualSocso, accrualEis, accrualPcb,
  /// accrualSalary, bonus, commission, overtime).
  ///
  /// `null` means the admin hasn't configured Xero sync yet — the
  /// sync paths fall back to "skip" with a friendly UI prompt.
  xeroMapping               Json?
  /// 10-digit Public Bank debiting account used as the payor on the
  /// PB ECP Payroll upload file. Required for the
  /// `BANK_PB_ECP_XLSX` report. Null when not configured — the modal
  /// surfaces a clear prompt to set it under Payroll Settings.
  ecpPayorAccountNo         String?
  /// SWIFT/BIC code of the payor's bank. Defaults to Public Bank
  /// (PBBEMYKL) since the PB ECP flow is targeted at Public Bank
  /// customers — admins can override if they're using a different
  /// bank's bulk-payroll service.
  ecpPayorBic               String?
  organization              Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Per-org employer filing profile. Updated rarely (~annual at most).
/// Separate from PayrollSettings because it's a different concern — the
/// "filing identity" of the company vs the operational rules. Matches
/// Altomate's `p_company_settings`.
model PayrollCompanyInfo {
  id                       String       @id @default(cuid())
  organizationId           String       @unique
  employerName             String?
  employerTin              String?
  registrationNo           String?
  referenceType            String?
  referenceNo              String?
  employerCategory         String?
  employerStatus           String?
  cp8dFurnishType          String?
  addressLine1             String?
  addressLine2             String?
  postcode                 String?
  city                     String?
  state                    String?
  country                  String?      @default("Malaysia")
  phone                    String?
  handphone                String?
  email                    String?
  taxAgentName             String?
  taxAgentTin              String?
  taxAgentLicenceNo        String?
  taxAgentPhone            String?
  taxAgentEmail            String?
  declarantName            String?
  declarantIdType          IdType?
  declarantIdNumber        String?
  declarantPosition        String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  taxAgentFirmAddressLine1 String?
  taxAgentFirmAddressLine2 String?
  taxAgentFirmCity         String?
  taxAgentFirmName         String?
  taxAgentFirmPostcode     String?
  taxAgentFirmState        String?
  perkesoEmployerCode      String?
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Saved login credentials for a single statutory portal (KWSP, PERKESO)
/// per organization. The password is symmetrically encrypted at rest
/// (AES-256-GCM, keyed off the `PORTAL_CREDS_KEY` env var); every other
/// field is plain text. The Payroll Settings → Credentials tab lets the
/// admin copy each field to the clipboard so they don't have to memorise
/// the login or fish it out of a password manager every time the LHDN /
/// SOCSO / EPF deadlines roll around. One row per (org, portal).
model PayrollPortalCredential {
  id               String       @id @default(cuid())
  organizationId   String
  portal           PortalKind
  /// Plain-text login ID.
  userId           String?
  /// AES-256-GCM ciphertext. Layout: iv(12) || authTag(16) || ciphertext,
  /// base64-encoded. Decrypt with `decryptSecret()` from `lib/crypto.ts`.
  /// Null when the admin hasn't saved a password yet.
  passwordEnc      String?
  /// KWSP-only: the image the admin chose at registration (e.g.
  /// "elephant"). Plain text.
  image            String?
  /// KWSP-only: secret code shown at login. Plain text.
  secretCode       String?
  /// PERKESO-only: security phrase. Plain text.
  securityPhrase   String?
  /// PERKESO-only: password reminder hint. Plain text.
  passwordReminder String?
  /// Free-form notes the admin wants to remember (e.g. "old PIC was
  /// Sarah, rotated 2026-03"). Plain text.
  notes            String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, portal])
  @@index([organizationId])
}

/// One payroll run per (org, year, month). Created in DRAFT state; the
/// admin reviews payslips, then submits → SUBMITTED. Submission is
/// revertible until the next month's run is submitted.
model PayrollRun {
  id                       String                 @id @default(cuid())
  organizationId           String
  periodYear               Int
  /// 1..12
  periodMonth              Int
  status                   PayrollRunStatus       @default(DRAFT)
  totalGross               Decimal?               @db.Decimal(14, 2)
  totalNet                 Decimal?               @db.Decimal(14, 2)
  totalEmployeeEpf         Decimal?               @db.Decimal(14, 2)
  totalEmployerEpf         Decimal?               @db.Decimal(14, 2)
  totalEmployeeSocso       Decimal?               @db.Decimal(14, 2)
  totalEmployerSocso       Decimal?               @db.Decimal(14, 2)
  totalEmployeeEis         Decimal?               @db.Decimal(14, 2)
  totalEmployerEis         Decimal?               @db.Decimal(14, 2)
  /// Sum of `Payslip.pcb` across the run. Computed by the PCB
  /// engine (`modules/payroll/domain/pcb.ts`) using LHDN's
  /// normal-remuneration + additional-remuneration formulas, with
  /// zakat offset applied. 0 for employees without an
  /// `incomeTaxNumber` on file (opt-in signal).
  totalPcb                 Decimal?               @default(0.00) @db.Decimal(14, 2)
  /// HRDF (HRD Corp levy) totalled across the run. Computed by
  /// `calcPayslip` when the org has `hrdfEnabled` and the employee is
  /// a Malaysian citizen.
  totalHrdf                Decimal?               @default(0.00) @db.Decimal(14, 2)
  totalZakat               Decimal?               @default(0.00) @db.Decimal(14, 2)
  employeeCount            Int?
  /// Only Malaysians count for HRDF eligibility.
  employeesSubjectToHrdf   Int?                   @default(0)
  totalWagesSubjectToHrdf  Decimal?               @default(0.00) @db.Decimal(14, 2)
  /// Gross + employer EPF + employer SOCSO + employer EIS + HRDF.
  totalCostToEmployer      Decimal?               @db.Decimal(14, 2)
  submittedAt              DateTime?
  submittedById            String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  /// Explicit "last content mutation" timestamp — set whenever an
  /// adjustment is saved/cleared OR a claim is attached/detached,
  /// and CLEARED when payroll is generated.
  ///
  /// Drives the "stale run" warning on the run detail page. The run
  /// is stale when this is non-null AND newer than the latest
  /// `Payslip.createdAt`. Null means "no pending mutations since the
  /// last generation" (or the run has never been mutated since
  /// migration). Status-only changes (submit / revert) don't touch
  /// this; only content mutations do.
  lastMutatedAt            DateTime?
  /// Optional free-text reason captured when the approver sends a
  /// pending run back to DRAFT. Stays on the run as an audit trail;
  /// gets shown to the original submitter when they re-open the run.
  approvalRejectionReason  String?
  /// When the run entered PENDING_APPROVAL (admin clicked
  /// "Submit for approval"). Distinct from `submittedAt`, which is
  /// when the FINAL approver pushed the run live.
  submittedForApprovalAt   DateTime?
  submittedForApprovalById String?
  /// Human-readable journal number / narration (echoed back from
  /// Xero). Surfaced on the run page so admins can find the entry
  /// in Xero quickly.
  xeroJournalNumber        String?
  /// Xero Manual Journal ID returned by the create-journal API
  /// after the admin approves this run. `null` until the sync runs.
  xeroManualJournalId      String?                @unique
  /// Captured error message when xeroSyncStatus = FAILED. Cleared
  /// on a retry that succeeds.
  xeroSyncError            String?                @db.Text
  /// Per-run sync status. NOT_SYNCED is the default; transitions to
  /// SYNCED on success or FAILED if Xero returned an error.
  xeroSyncStatus           XeroSyncStatus         @default(NOT_SYNCED)
  xeroSyncedAt             DateTime?
  /// JSON array of EmployeePolicy ids whose employees this run covers.
  /// `null` = no scope = every employee in the org (legacy / org-wide
  /// behaviour). When non-null, payslip generation only pulls employees
  /// whose `EmployeeProfile.policyId` is in this list. The unique
  /// `(orgId, periodYear, periodMonth)` constraint stays — there's
  /// still only one run per month per org; this scope just narrows
  /// WHO gets paid in that run. Empty array would be valid but
  /// useless (no employees), so the picker enforces ≥ 1 entry.
  policyIds                Json?
  /// COMPUTED = produced by calc engine (the normal path). IMPORTED =
  /// seeded from a YTD migration upload — the payslip numbers are
  /// taken as-typed by the admin, not recomputed. Imported runs are
  /// surfaced in their own card on /admin/payroll/runs so it's
  /// obvious which history is engine-computed vs migrated.
  source                   PayrollRunSource       @default(COMPUTED)
  organization             Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submittedBy              User?                  @relation("PayrollRunSubmittedBy", fields: [submittedById], references: [id])
  submittedForApprovalBy   User?                  @relation("PayrollRunSubmittedForApprovalBy", fields: [submittedForApprovalById], references: [id])
  adjustments              PayrollRunAdjustment[]
  claimAttachments         PayrollRunClaim[]
  reports                  PayrollRunReport[]
  payslips                 Payslip[]

  @@unique([organizationId, periodYear, periodMonth])
  @@index([organizationId, status])
  @@index([submittedById], map: "PayrollRun_submittedById_fkey")
  @@index([submittedForApprovalById], map: "PayrollRun_submittedForApprovalById_fkey")
}

/// One row per generated downloadable file for a payroll run (payroll
/// summary PDF, EPF CSV, SOCSO+EIS TXT, PCB TXT, etc.). Built lazily on
/// the first "Download" click from the modal, then cached so repeat
/// clicks serve instantly without re-rendering.
///
/// Lifecycle:
/// - Created on first download click after a run is SUBMITTED.
/// - Cascade-deleted when the run is deleted.
/// - Explicitly deleted (+ file removed from disk) when the run is
/// reverted to draft, so the next re-submit produces fresh files
/// matching the (potentially changed) numbers.
///
/// The actual file bytes live under
/// `public/uploads/payroll-reports/{runId}/{kind}.{ext}`
/// and are reachable via `fileUrl`. We keep a `contentHash` for
/// optional change detection if we later add a "regenerate if changed"
/// flow.
model PayrollRunReport {
  id           String            @id @default(cuid())
  payrollRunId String
  kind         PayrollReportKind
  /// Final filename the user sees on download
  /// (e.g. `Payroll_Summary_January_2026.pdf`). Derived from the run's
  /// period + the report kind at generation time.
  fileName     String
  /// `/uploads/payroll-reports/{runId}/{kind}.{ext}` — relative to
  /// `public/`, served directly by Next.js' static file handler.
  fileUrl      String
  mimeType     String
  sizeBytes    Int
  /// SHA-256 of the file bytes, hex-encoded.
  contentHash  String
  generatedAt  DateTime          @default(now())
  payrollRun   PayrollRun        @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, kind])
  @@index([payrollRunId])
}

/// Year-level annual tax forms aggregating every SUBMITTED run in a
/// calendar year. Cached lazily on first download — busted whenever
/// any underlying run for the year changes state (approve / revert /
/// delete) so the cached file always reflects the live SUBMITTED set.
///
/// Cascade on org delete; explicit cleanup on run state changes via
/// `payrollAnnualReportRepository.deleteForYear`.
model PayrollAnnualReport {
  id             String                  @id @default(cuid())
  organizationId String
  /// Calendar year (e.g. 2026 covers Jan-Dec 2026 SUBMITTED runs).
  year           Int
  kind           PayrollAnnualReportKind
  fileName       String
  fileUrl        String
  mimeType       String
  sizeBytes      Int
  contentHash    String
  generatedAt    DateTime                @default(now())
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, year, kind])
  @@index([organizationId, year])
}

/// Join row attaching an approved (SYNCED + PERSONAL paymentType)
/// AltomateHR claim to a payroll run as a REIMBURSEMENT. Persisted
/// separately from `PayslipLineItem` because the run's payslips are
/// re-generated from scratch on each "Generate" press, so the line
/// items get wiped — this row is the source of truth that survives.
///
/// The actual `PayslipLineItem` is recreated from this attachment on
/// each generation, with `claimId` pointing back here for traceability.
///
/// Snapshots `label` + `amount` at attach time so later edits to the
/// underlying claim don't change historical payroll figures.
model PayrollRunClaim {
  id                String          @id @default(cuid())
  payrollRunId      String
  /// One claim → at most one attachment ever. Detaching deletes the
  /// row; re-attaching to another run creates a new one.
  claimId           String          @unique
  employeeProfileId String
  label             String
  amount            Decimal         @db.Decimal(12, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  claim             Claim           @relation(fields: [claimId], references: [id], onDelete: Cascade)
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  payrollRun        PayrollRun      @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@index([payrollRunId])
  @@index([employeeProfileId])
}

/// Per-run-per-employee adjustment row. Captures OT hours,
/// one-off allowances + deductions, and a manually-entered
/// unpaid-leave amount. Survives payslip regeneration (PayslipLineItem
/// rows are recreated from these on each "Generate" press).
///
/// One row per (runId, employeeProfileId). Admins fill these in from
/// the per-employee adjustment page; the generator merges them in
/// alongside fixed adjustments (from PayrollProfile) and reimbursements
/// (from PayrollRunClaim).
model PayrollRunAdjustment {
  id                      String          @id @default(cuid())
  payrollRunId            String
  employeeProfileId       String
  otNormalHours           Decimal         @default(0.00) @db.Decimal(8, 2)
  otRestHours             Decimal         @default(0.00) @db.Decimal(8, 2)
  otPublicHours           Decimal         @default(0.00) @db.Decimal(8, 2)
  /// JSON array of one-off adjustments for this run only:
  /// `[{ kind: "ALLOWANCE" | "DEDUCTION", label, amount }]`. Stacked on
  /// top of the PayrollProfile's fixed adjustments.
  manualLineItems         Json
  notes                   String?         @db.Text
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  /// Per-run overrides on the PayrollProfile's recurring fixed
  /// adjustments. Keyed by the profile's fixed-allowance index as a
  /// string, so the JSON shape is:
  /// `{ "0": { "amount": 250, "skip": false }, "2": { "skip": true } }`
  /// Missing index = use the profile default. `skip=true` zeroes the
  /// row for this run only; `amount` overrides the value while keeping
  /// the original category (so EPF/SOCSO/EIS/PCB subject-to flags
  /// follow through correctly).
  fixedAllowanceOverrides Json
  expectedHours           Decimal?        @db.Decimal(8, 2)
  /// Per-run overrides of the auto-computed regular working hours.
  /// Null = use the value derived from attendance + paid leave. For
  /// MONTHLY staff `workedHours / expectedHours` is the pay proration
  /// factor (the HRS % column); for HOURLY staff `workedHours` is the
  /// paid quantity. See PayrollRunAdjustmentData / calcPayslip.
  workedHours             Decimal?        @db.Decimal(8, 2)
  employeeProfile         EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  payrollRun              PayrollRun      @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeProfileId])
  @@index([payrollRunId])
  @@index([employeeProfileId], map: "PayrollRunAdjustment_employeeProfileId_fkey")
}

/// One per (run, employee). Snapshots employee data at the moment of
/// generation so later edits to PayrollProfile don't rewrite payroll
/// history.
model Payslip {
  id                    String            @id @default(cuid())
  payrollRunId          String
  employeeProfileId     String
  /// Nullable so we can keep payslips when a PayrollProfile is later
  /// archived/deleted. The snapshot fields hold the source-of-truth
  /// values; this FK is only for "fetch latest profile" UX.
  payrollProfileId      String?
  snapshotName          String
  snapshotEmployeeId    String
  snapshotPosition      String?
  snapshotSalaryType    SalaryType
  snapshotMonthlySalary Decimal?          @db.Decimal(12, 2)
  snapshotHourlyRate    Decimal?          @db.Decimal(12, 2)
  snapshotNationality   String?
  snapshotIsResident    Boolean           @default(true)
  /// JSON: { employee, employer, voluntaryEmployee, voluntaryEmployer }
  snapshotEpfRates      Json
  basicPay              Decimal           @db.Decimal(12, 2)
  proratedPay           Decimal           @db.Decimal(12, 2)
  workedHours           Decimal?          @db.Decimal(8, 2)
  proratedFactor        Decimal           @default(1.0000) @db.Decimal(5, 4)
  proratedDays          Int?
  totalWorkingDays      Int?
  otNormalHours         Decimal           @default(0.00) @db.Decimal(8, 2)
  otRestHours           Decimal           @default(0.00) @db.Decimal(8, 2)
  otPublicHours         Decimal           @default(0.00) @db.Decimal(8, 2)
  otPay                 Decimal           @default(0.00) @db.Decimal(12, 2)
  totalAllowances       Decimal           @default(0.00) @db.Decimal(12, 2)
  /// Sum of REIMBURSEMENT line items (from AltomateHR claims).
  totalReimbursements   Decimal           @default(0.00) @db.Decimal(12, 2)
  totalDeductions       Decimal           @default(0.00) @db.Decimal(12, 2)
  epfEmployee           Decimal           @default(0.00) @db.Decimal(12, 2)
  epfEmployer           Decimal           @default(0.00) @db.Decimal(12, 2)
  socsoEmployee         Decimal           @default(0.00) @db.Decimal(12, 2)
  socsoEmployer         Decimal           @default(0.00) @db.Decimal(12, 2)
  eisEmployee           Decimal           @default(0.00) @db.Decimal(12, 2)
  eisEmployer           Decimal           @default(0.00) @db.Decimal(12, 2)
  /// SKBBK (Skim LINDUNG 24 Jam / Non-Employment Injury Scheme) —
  /// employee-only contribution effective 1 Jun 2026. 0 for payslips
  /// before that month or for non-Akta-4 employees. Default 0 also
  /// covers historical rows from before this column existed.
  skbbkEmployee         Decimal           @default(0.00) @db.Decimal(12, 2)
  /// Wage base used to look up SKBBK from the gazette table —
  /// equals socso wage in current code but persisted separately so
  /// historical payslips remain interpretable if PERKESO ever
  /// decouples the two wage definitions.
  skbbkWage             Decimal           @default(0.00) @db.Decimal(12, 2)
  pcb                   Decimal           @default(0.00) @db.Decimal(12, 2)
  hrdf                  Decimal           @default(0.00) @db.Decimal(12, 2)
  zakat                 Decimal           @default(0.00) @db.Decimal(12, 2)
  /// Wage base used for HRDF — may differ from gross.
  hrdfWage              Decimal           @default(0.00) @db.Decimal(12, 2)
  grossPay              Decimal           @db.Decimal(12, 2)
  netPay                Decimal           @db.Decimal(12, 2)
  totalCostToEmployer   Decimal           @db.Decimal(12, 2)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  /// Sum of non-cash BIK / perquisite line items. NOT included in
  /// `grossPay` or `netPay` (employee never receives this in cash),
  /// but DOES feed the PCB taxable base for line items that have
  /// `subjectToPcb: true`. Surfaced separately on the payslip and
  /// in Form EA disclosures.
  totalBenefitsInKind   Decimal           @default(0.00) @db.Decimal(12, 2)
  /// Leave-adjusted expected hours for the period (scheduled hours over
  /// the effective employment window minus approved paid leave). For
  /// MONTHLY staff `workedHours / expectedHours` is the proration factor
  /// snapshot. Null for HOURLY staff (no expected basis).
  expectedHours         Decimal?          @db.Decimal(8, 2)
  /// Approved UNPAID leave days taken in the period (paid leave excluded).
  /// Display-only snapshot for the DAYS column: actual working days =
  /// totalWorkingDays − unpaidLeaveDays. Does NOT affect pay.
  unpaidLeaveDays       Decimal?          @db.Decimal(5, 2)
  /// LHDN-style PCB formula breakdown — the line-by-line variables
  /// (Y, K, Y1, K1, Y2, K2, n, D, S, Du, Su, Q×C, ∑LP, LP1, P, M, R,
  /// B, Z, X, yearlyTax, currentMonthPcb) that produced the `pcb`
  /// number above. Snapshotted at generation so the Detailed
  /// Calculations PDF can always show the formula that yielded the
  /// actually-deducted amount, even if rates / formula change later.
  /// Shape matches `CalcPcbBreakdown` in `modules/payroll/domain/pcb.ts`.
  /// Null on payslips generated before this column shipped — the PDF
  /// falls back to a single-line summary for those.
  ///
  /// Named `pcbCalculation` to avoid colliding with the in-memory
  /// `CalcPayslipResult.pcbBreakdown` field (which is just the
  /// `{normal, additional}` amount split).
  pcbCalculation        Json?
  employeeProfile       EmployeeProfile   @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  payrollProfile        PayrollProfile?   @relation(fields: [payrollProfileId], references: [id])
  payrollRun            PayrollRun        @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  lineItems             PayslipLineItem[]

  @@unique([payrollRunId, employeeProfileId])
  @@index([employeeProfileId])
  @@index([payrollProfileId], map: "Payslip_payrollProfileId_fkey")
}

/// Individual line items on a payslip — allowances, deductions,
/// reimbursements. Maps to Altomate's "additions JSON" but normalised
/// so claim FKs are queryable.
model PayslipLineItem {
  id             String          @id @default(cuid())
  payslipId      String
  kind           PayslipLineKind
  /// Display label. For reimbursements, this is the claim's title.
  label          String
  /// Positive for ALLOWANCE/REIMBURSEMENT, positive for DEDUCTION (the
  /// kind determines sign at calc time).
  amount         Decimal         @db.Decimal(12, 2)
  /// FK to the original AltomateHR claim when this line item is a
  /// REIMBURSEMENT. Unique so a single claim can only ever sit on one
  /// payslip line item. NULL for manual allowance/deduction entries.
  claimId        String?         @unique
  subjectToEpf   Boolean         @default(true)
  subjectToSocso Boolean         @default(true)
  subjectToEis   Boolean         @default(true)
  subjectToPcb   Boolean         @default(true)
  createdAt      DateTime        @default(now())
  /// `PayrollAdjustmentCategory` code (e.g. `allowance_childcare`,
  /// `wages_bonus_annual`, `deduct_zakat`). Snapshotted at write time
  /// so the run service can sum YTD-by-category for `taxExemptLimit`
  /// enforcement on the next run. Nullable only for legacy rows
  /// written before this column existed; new line items always carry
  /// one.
  category       String?
  claim          Claim?          @relation(fields: [claimId], references: [id])
  payslip        Payslip         @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
}

/// A staff loan / cash advance the company gives an employee, repaid
/// via automatic monthly DEDUCTION line items on each payroll run
/// within the repayment window. Only admins create these. The monthly
/// installment lands on the payslip under category `deduct_advance`
/// (so it flows through the statutory-aware calc and the Xero deduction
/// credit). Repayment progress (paid / remaining) is derived from the
/// SUBMITTED runs whose period falls inside the window — see
/// `modules/payroll/domain/loans.ts`.
model EmployeeLoan {
  id                String            @id @default(cuid())
  organizationId    String
  employeeProfileId String
  /// Total advanced to the employee.
  principalAmount   Decimal           @db.Decimal(12, 2)
  /// FIXED  → installment = principal / installmentCount (system split).
  /// CUSTOM → installment = `installmentAmount` each month; count is
  /// derived (ceil(principal / amount)), last one is the
  /// remainder.
  mode              LoanRepaymentMode
  /// The per-month deduction. For FIXED this is principal/count
  /// (snapshotted at create time); for CUSTOM it's the admin-entered
  /// amount.
  installmentAmount Decimal           @db.Decimal(12, 2)
  /// First repayment period (1..12 + year). Repayment runs for
  /// `installmentCount` consecutive months starting here.
  startYear         Int
  /// 1..12
  startMonth        Int
  installmentCount  Int
  status            LoanStatus        @default(ACTIVE)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  /// Per-installment amounts as a JSON number[] (length =
  /// installmentCount). Source of truth for each month's deduction —
  /// lets Custom-mode loans carry uneven installments and lets the
  /// admin edit not-yet-paid installments while keeping the total equal
  /// to `principalAmount`. Legacy rows without it fall back to the
  /// computed equal-installment schedule.
  schedule          Json?
  employeeProfile   EmployeeProfile   @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([employeeProfileId])
}

/// Admin-configured leave type for an organization (e.g. ANNUAL, SICK,
/// UNPAID, MATERNITY). `accrualMethod=PRO_RATED` is intended for the
/// org's annual leave only — UI gates this. `carryForward` likewise
/// only applies to annual leave.
model LeaveType {
  id                  String                   @id @default(cuid())
  organizationId      String
  code                String
  name                String
  /// When false, leave is unpaid: defaultDays is ignored and attendance
  /// expected-hours is NOT reduced when an employee takes this leave.
  paid                Boolean                  @default(true)
  accrualMethod       LeaveAccrualMethod       @default(LUMP_SUM)
  /// Fallback org-wide default entitlement when no PolicyLeaveEntitlement
  /// row exists for the employee's policy.
  defaultDays         Float                    @default(0)
  carryForward        Boolean                  @default(false)
  /// 1-12 — month in the new year after which carried days expire.
  /// Required when carryForward = true.
  carryExpiryMonth    Int?
  /// Optional cap on carriedDays at rollover. Null = uncapped.
  maxCarryForwardDays Float?
  archivedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  /// When true AND `accrualMethod === LUMP_SUM`, mid-year hires get a
  /// prorated portion of `defaultDays` in their year-of-hire only.
  /// Year 2+ resets to the full quota via the year-rollover cron.
  /// Only meaningful for the Annual Leave type (admins are gated to
  /// Annual in the LeaveTypeDialog). Ignored for PRO_RATED (which
  /// already prorates by design) and for non-Annual types.
  prorateFirstYear    Boolean                  @default(false)
  applications        LeaveApplication[]
  entitlements        LeaveEntitlement[]
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policyDefaults      PolicyLeaveEntitlement[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// Per-policy override of a LeaveType's defaultDays. Resolution order
/// for an employee's entitlement default:
/// 1. Per-employee LeaveEntitlement (if set)
/// 2. PolicyLeaveEntitlement (if a row exists for the employee's policy)
/// 3. LeaveType.defaultDays
model PolicyLeaveEntitlement {
  id            String              @id @default(cuid())
  policyId      String
  leaveTypeId   String
  defaultDays   Float               @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  /// Per-policy override of `LeaveType.accrualMethod`. Null = inherit
  /// the type's method. See resolveAccrualMethod() in
  /// modules/leave/application/services/leave-entitlements.service.ts.
  accrualMethod LeaveAccrualMethod?
  leaveType     LeaveType           @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  policy        EmployeePolicy      @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, leaveTypeId])
  @@index([leaveTypeId])
}

/// One row per (employee, leaveType, year). Created on demand or by the
/// year-rollover cron. For LUMP_SUM the full entitledDays is available
/// immediately; for PRO_RATED only accruedDays is available.
model LeaveEntitlement {
  id                     String              @id @default(cuid())
  employeeId             String
  leaveTypeId            String
  year                   Int
  entitledDays           Float
  carriedDays            Float               @default(0)
  carriedExpiresAt       DateTime?
  carriedExpired         Boolean             @default(false)
  /// PRO_RATED: monthly accumulated. LUMP_SUM: equals entitledDays.
  accruedDays            Float               @default(0)
  usedDays               Float               @default(0)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  /// Per-employee override of accrualMethod. Null = inherit from
  /// PolicyLeaveEntitlement (if set) or LeaveType. See
  /// resolveAccrualMethod() in
  /// modules/leave/application/services/leave-entitlements.service.ts.
  accrualMethod          LeaveAccrualMethod?
  /// Snapshot of the cash-out amount actually attached to the run,
  /// in case the employee's salary changes later.
  carriedCashedOutAmount Decimal?            @db.Decimal(12, 2)
  carriedCashedOutAt     DateTime?
  /// Non-null = an admin has attached this expired-days row to a
  /// payroll run for cash-out. We don't show it as "available" again
  /// and we don't re-attach on re-imports. No onDelete cascade — keep
  /// the audit if the run is deleted.
  carriedCashedOutRunId  String?
  /// Set by `runMonthlyAccrual`'s expiry sweep when this row's
  /// carry-forward expired. Lets the payroll cash-out UI surface
  /// "this employee had X days expire on date Y" even after
  /// `carriedDays` is mutated to the used portion.
  carriedExpiredAt       DateTime?
  /// How many days were forfeited when the expiry fired — i.e. the
  /// `unused` portion at sweep time. Stays on the row indefinitely
  /// so the cash-out UI knows the amount even years later.
  carriedExpiredDays     Float?
  employee               EmployeeProfile     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType              LeaveType           @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([leaveTypeId])
  @@index([year])
  @@index([carriedExpired, carriedCashedOutRunId])
}

/// Employee leave application. Approval chain mirrors the attendance
/// pattern via `modules/organization/.../approval-chain.service.ts`
/// with module = LEAVE. Auto-approves when no layers exist above the
/// employee for the LEAVE module.
model LeaveApplication {
  id             String          @id @default(cuid())
  employeeId     String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  /// MORNING / AFTERNOON only valid when startDate == endDate.
  duration       LeaveDuration   @default(FULL_DAY)
  /// Computed at submit: 0.5 for half-day, otherwise count of working
  /// days in [startDate, endDate] per org/team working-days rule.
  totalDays      Float
  reason         String?         @db.Text
  status         LeaveStatus     @default(PENDING)
  currentStep    Int             @default(0)
  /// JSON array of { step, approverId, decidedAt, decision, notes? }
  approvals      Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  decidedAt      DateTime?
  /// Original filename, surfaced in the UI for clarity ("mc-2026-05-20.pdf").
  attachmentName String?
  /// URL the UI consumes to display the attachment. Either the Xero
  /// Files proxy route (/api/leave/files/{xeroFileId}/content) when the
  /// org has a usable Xero connection, or a local /uploads/... path as
  /// fallback. Null when the employee didn't upload anything.
  attachmentUrl  String?
  /// Xero Files API id when the attachment lives in Xero. Null for local
  /// fallback uploads. Used by the proxy route to look up & authorise.
  xeroFileId     String?
  employee       EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([startDate, endDate])
}

/// Per-organization audit / activity log. Records who did what (and
/// what failed) inside each org for the last 7 days; a daily cron at
/// /api/cron/audit-prune deletes anything older. Surfaced in the
/// admin Settings → Activity log tab.
///
/// Identity fields are SNAPSHOTTED (actorEmail / actorName) so the row
/// stays human-readable even if the User row is later deleted. The FK
/// to User is kept for joining recent rows back to live profiles, but
/// `onDelete: SetNull` makes the row outlive the user.
///
/// `partnerInitiated = true` flags actions originating from a partner
/// API call (POST /api/v1/admin/admins etc.) rather than a human in
/// the admin portal. The actor is still the human if SSO; the flag
/// just notes the entry point.
model OrganizationAuditLog {
  id               String       @id @default(cuid())
  organizationId   String
  actorUserId      String?
  actorRole        String?
  actorEmail       String
  actorName        String
  action           String
  status           String
  summary          String       @db.Text
  errorReason      String?      @db.Text
  targetType       String?
  targetId         String?
  metadata         Json?
  ipAddress        String?
  partnerInitiated Boolean      @default(false)
  createdAt        DateTime     @default(now())
  actor            User?        @relation("OrgAuditLogActor", fields: [actorUserId], references: [id])
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([actorUserId], map: "OrganizationAuditLog_actorUserId_fkey")
}

