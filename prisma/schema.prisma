  /// Seeded from a YTD import. Payslip numbers are taken from the
  /// uploaded XLSX as-is and never recomputed; the run is created
  /// with status = SUBMITTED + the imported `submittedAt` set to the
  /// last day of the period.
  IMPORTED
}

