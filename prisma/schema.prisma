generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                     String              @id @default(cuid())
  email                  String              @unique
  name                   String
  role                   UserRole
  organizationId         String?
  passwordHash           String
  avatarUrl              String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  adminOrganizations     AdminOrganization[] @relation("AdminOrganizations")
  approvalChainApprovals ApprovalChainStep[] @relation("ApproverChain")
  approvalChainSteps     ApprovalChainStep[] @relation("EmployeeChain")
  approvals              ApprovalRequest[]   @relation("EmployeeApprovals")
  approvalReviews        ApprovalRequest[]   @relation("ReviewerApprovals")
  attendance             AttendanceRecord[]  @relation("EmployeeAttendance")
  claims                 Claim[]             @relation("EmployeeClaims")
  reviews                Claim[]             @relation("AdminReviews")
  supervisedProfiles     EmployeeProfile[]   @relation("SupervisorReports")
  employeeProfile        EmployeeProfile?    @relation("EmployeeProfileUser")
  pushSubscriptions      PushSubscription[]
  organization           Organization?       @relation(fields: [organizationId], references: [id])
  xeroConnections        XeroConnection[]    @relation("XeroConnectedBy")
  managedProjects        XeroProject[]       @relation("ProjectManager")
  projectManagerOf       ProjectManager[]    @relation("ProjectManagerOf")

  @@index([organizationId])
}

model Organization {
  id                       String                   @id @default(cuid())
  name                     String                   @unique
  claimCutoffDay           Int                      @default(25)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  workingHoursEnd          String                   @default("18:00")
  workingHoursStart        String                   @default("09:00")
  bankAccount              String?
  otRateNormalDay          Decimal             @default(1.50) @db.Decimal(4, 2)
  otRatePublicHoliday      Decimal             @default(3.00) @db.Decimal(4, 2)
  otRateRestDay            Decimal             @default(2.00) @db.Decimal(4, 2)
  otSalaryThreshold        Decimal             @default(4000.00) @db.Decimal(10, 2)
  publicHolidayInShiftRate Decimal             @default(2.00) @db.Decimal(4, 2)
  restDayInShiftRate       Decimal             @default(1.00) @db.Decimal(4, 2)
  geofenceRadiusMeters     Int                 @default(200)
  defaultMileageRate       Decimal?            @db.Decimal(10, 4)
  mileageUnit              MileageUnit         @default(KM)
  otEnabled                Boolean             @default(true)
  adminMembers             AdminOrganization[]
  chartAccounts            ChartOfAccount[]
  claims                   Claim[]
  users                    User[]
  xeroConnections          XeroConnection[]
  projects                 XeroProject[]
}

model AdminOrganization {
  id             String       @id @default(cuid())
  adminId        String
  organizationId String
  createdAt      DateTime     @default(now())
  admin          User         @relation("AdminOrganizations", fields: [adminId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([adminId, organizationId])
  @@index([adminId])
  @@index([organizationId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmployeeProfile {
  id                 String                        @id @default(cuid())
  userId             String                        @unique
  employeeId         String                        @unique
  project            String                        @map("department")
  jobTitle           String
  supervisorId       String?
  payoutMethod       PayoutMethod?
  /// Pay rate per hour. Only populated for employees whose payoutMethod
  /// is HOURLY; null for MONTHLY_BASED employees and supervisors.
  hourlyRate         Decimal?                      @db.Decimal(10, 2)
  preferredCurrency  String                        @default("USD")
  xeroConnectionId   String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  supervisor         User?                         @relation("SupervisorReports", fields: [supervisorId], references: [id])
  user               User                          @relation("EmployeeProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  xeroConnection     XeroConnection?               @relation(fields: [xeroConnectionId], references: [id])
  projectAssignments EmployeeProjectAssignment[]
  teamMemberships    EmployeeTeamMembership[]

  @@index([supervisorId])
  @@index([xeroConnectionId])
}

model EmployeeProjectAssignment {
  id                String          @id @default(cuid())
  employeeProfileId String
  projectId         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  project           XeroProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, projectId])
  @@index([employeeProfileId])
  @@index([projectId])
}

model Claim {
  id               String          @id @default(cuid())
  claimNumber      String          @unique
  title            String
  description      String          @db.Text
  category         ClaimCategory
  claimType        ClaimType       @default(EXPENSE)
  organizationId   String?
  /// Project this claim is filed against. Drives approval routing — when
  /// set, the claim follows the employee's team chain in this project.
  /// Nullable for legacy claims that pre-date the project picker; new
  /// submissions require it whenever the employee has any project
  /// assignments.
  projectId        String?
  chartOfAccountId String?
  amount           Decimal         @db.Decimal(12, 2)
  currency         String          @default("USD")
  spentAt          DateTime
  submittedAt      DateTime        @default(now())
  claimRunMonth    DateTime?
  reviewedAt       DateTime?
  paymentType      PaymentType     @default(PERSONAL)
  payViaAccountId  String?
  status           ClaimStatus     @default(PENDING)
  /// True when the claim's amount blew past the chart-of-account spend
  /// limit at submission time. The claim is still saved (employees can
  /// submit over-limit), but admins see a visual flag in their queue.
  exceedsLimit     Boolean         @default(false)
  receiptUrl       String?
  reviewNotes      String?         @db.Text
  // Snapshot of the reviewer's role at decision time (SUPERVISOR or ADMIN).
  // Denormalized so we can filter "approved/rejected by supervisor vs admin"
  // without joining to User, and so history is preserved if the reviewer's
  // role later changes or the user is deleted.
  reviewerRole     UserRole?
  // Mileage-claim fields (only populated when claimType = MILEAGE).
  distance                    Decimal? @db.Decimal(10, 2)
  mileageOriginAddress        String?
  mileageDestinationAddress   String?
  // Snapshot of the rate that was used at submission time so historical claims
  // never change when the admin updates the rate later.
  mileageRateUsed             Decimal? @db.Decimal(10, 4)
  mileageUnitUsed             MileageUnit?
  employeeId       String
  reviewerId       String?
  xeroBillId       String?         @unique
  xeroBillRef      String?
  xeroSyncStatus   XeroSyncStatus  @default(NOT_SYNCED)
  xeroSyncError    String?         @db.Text
  xeroSyncedAt     DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  chartOfAccount   ChartOfAccount? @relation("ClaimAccount", fields: [chartOfAccountId], references: [id])
  employee         User            @relation("EmployeeClaims", fields: [employeeId], references: [id], onDelete: Cascade)
  organization     Organization?   @relation(fields: [organizationId], references: [id])
  project          XeroProject?    @relation("ClaimProject", fields: [projectId], references: [id])
  payViaAccount    ChartOfAccount? @relation("ClaimPayViaAccount", fields: [payViaAccountId], references: [id])
  reviewer         User?           @relation("AdminReviews", fields: [reviewerId], references: [id])

  @@index([organizationId, submittedAt])
  @@index([chartOfAccountId])
  @@index([employeeId, submittedAt])
  @@index([payViaAccountId], map: "Claim_payViaAccountId_fkey")
  @@index([status, submittedAt])
  @@index([xeroSyncStatus])
  @@index([reviewerId], map: "Claim_reviewerId_fkey")
  @@index([projectId])
}

model ChartOfAccount {
  id                                          String          @id @default(cuid())
  organizationId                              String
  xeroConnectionId                            String?
  xeroAccountId                               String?
  code                                        String
  name                                        String
  type                                        String?
  status                                      String?
  isSelectable                                Boolean         @default(false)
  isCustom                                    Boolean         @default(false)
  createdAt                                   DateTime        @default(now())
  updatedAt                                   DateTime        @updatedAt
  isBankAccount                               Boolean         @default(false)
  isDisabled                                  Boolean         @default(false)
  allowMileageClaim                           Boolean         @default(false)
  limitAmount                                 Decimal?        @db.Decimal(12, 2)
  limitPeriod                                 LimitPeriod?
  limitScope                                  LimitScope?
  mileageRate                                 Decimal?        @db.Decimal(10, 4)
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  xeroConnection   XeroConnection? @relation(fields: [xeroConnectionId], references: [id], onDelete: Cascade)
  claims           Claim[]         @relation("ClaimAccount")
  paidClaims       Claim[]         @relation("ClaimPayViaAccount")

  @@unique([xeroConnectionId, xeroAccountId])
  @@unique([organizationId, code])
  @@index([organizationId, xeroConnectionId, isSelectable])
  @@index([organizationId, isBankAccount])
}

model XeroConnection {
  id                   String            @id @default(cuid())
  provider             String            @default("xero")
  organizationId       String
  tenantId             String            @unique
  tenantName           String
  tenantType           String?
  accessToken          String            @db.Text
  refreshToken         String            @db.Text
  scope                String            @db.Text
  tokenType            String
  accessTokenExpiresAt DateTime
  connectedByAdminId   String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  chartAccounts        ChartOfAccount[]
  employeeProfiles     EmployeeProfile[]
  connectedByAdmin     User?             @relation("XeroConnectedBy", fields: [connectedByAdminId], references: [id])
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  xeroProjects         XeroProject[]

  @@unique([organizationId, tenantId])
  @@index([organizationId])
  @@index([provider])
  @@index([connectedByAdminId])
}

model XeroProject {
  id                String                      @id @default(cuid())
  organizationId    String
  xeroConnectionId  String?
  xeroProjectId     String?
  name              String
  status            String?
  contactId         String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  isManual          Boolean                     @default(false)
  location          String?
  projectManagerId  String?
  isDisabled        Boolean                     @default(false)
  latitude          Float?
  longitude         Float?
  workingHoursStart String?
  workingHoursEnd   String?
  workingDays       String?
  attendanceRecords AttendanceRecord[]          @relation("AttendanceRecordProject")
  assignedEmployees EmployeeProjectAssignment[]
  claims            Claim[]                     @relation("ClaimProject")
  holidays          ProjectHoliday[]
  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectManager    User?                       @relation("ProjectManager", fields: [projectManagerId], references: [id])
  projectManagers   ProjectManager[]            @relation("ProjectManagers")
  xeroConnection    XeroConnection?             @relation(fields: [xeroConnectionId], references: [id], onDelete: Cascade)
  teams             Team[]

  @@unique([xeroConnectionId, xeroProjectId])
  @@index([xeroConnectionId, name])
  @@index([organizationId], map: "XeroProject_organizationId_fkey")
  @@index([projectManagerId])
}

model ProjectHoliday {
  id        String      @id @default(cuid())
  projectId String
  date      DateTime    @db.Date
  name      String
  createdAt DateTime    @default(now())
  project   XeroProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
  @@index([projectId])
}

/// Many-to-many between XeroProject and User for project managers. Replaces
/// the legacy single XeroProject.projectManagerId column (which is kept
/// during migration but no longer the source of truth).
model ProjectManager {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime    @default(now())
  project   XeroProject @relation("ProjectManagers", fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation("ProjectManagerOf", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model AttendanceRecord {
  id          String           @id @default(cuid())
  employeeId  String
  date        DateTime
  timeIn      DateTime?
  timeOut     DateTime?
  durationMin Int?
  lateByMin   Int?
  location    String?
  project     String?
  status      AttendanceStatus @default(MISSING)
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  projectId   String?
  employee    User             @relation("EmployeeAttendance", fields: [employeeId], references: [id], onDelete: Cascade)
  projectRef  XeroProject?     @relation("AttendanceRecordProject", fields: [projectId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@index([status, date])
  @@index([projectId])
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  employeeId  String
  reviewerId  String?
  kind        ApprovalKind
  status      ApprovalStatus @default(PENDING)
  date        DateTime
  eventAt     DateTime?
  title       String
  detail      String         @db.Text
  location    String?
  otSubtype   OTSubtype?
  lateMinutes Int?
  offsetRef   String?
  reviewNotes String?        @db.Text
  submittedAt DateTime       @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     String?
  employee    User           @relation("EmployeeApprovals", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer    User?          @relation("ReviewerApprovals", fields: [reviewerId], references: [id])

  @@index([employeeId, date])
  @@index([status, date])
  @@index([kind, status])
  @@index([reviewerId], map: "ApprovalRequest_reviewerId_fkey")
}

model ApprovalChainStep {
  id         String   @id @default(cuid())
  employeeId String
  /// teamId scopes this chain step to a specific team. An employee in
  /// multiple projects has one chain per team. Null only on legacy rows
  /// that pre-date the per-team migration; the backfill script fills these
  /// in from the employee's existing team membership.
  teamId     String?
  step       Int
  approverId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  approver   User     @relation("ApproverChain", fields: [approverId], references: [id])
  employee   User     @relation("EmployeeChain", fields: [employeeId], references: [id], onDelete: Cascade)
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Multiple approvers can sit at the same step (any-of approval). The
  // unique key now includes approverId, which means each (employee, team,
  // step, approver) combo is still distinct, but a single step can hold
  // multiple rows with different approverIds.
  @@unique([employeeId, teamId, step, approverId])
  @@index([employeeId])
  @@index([approverId])
  @@index([teamId])
}

/// Team-based approval template attached to a XeroProject. Each team has a
/// fixed number of hierarchy layers and a per-module config that says which
/// layers must approve for each module (CLAIMS, OT, LEAVE, ATTENDANCE).
/// Employees join a team at a specific layer; their effective approval chain
/// for a given module is filtered by the team's moduleConfig.
model Team {
  id           String                   @id @default(cuid())
  projectId    String
  name         String
  layerCount   Int                      @default(1)
  layerLabels  Json?
  moduleConfig Json
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  project      XeroProject              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberships  EmployeeTeamMembership[]
  chainSteps   ApprovalChainStep[]

  @@unique([projectId, name])
  @@index([projectId])
}

/// Joins an EmployeeProfile to a Team at a specific hierarchy layer (1-indexed,
/// must be <= team.layerCount). One row per (employee, team) — an employee
/// belongs to at most one layer per team.
model EmployeeTeamMembership {
  id                String          @id @default(cuid())
  employeeProfileId String
  teamId            String
  layer             Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  team              Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, teamId])
  @@index([teamId, layer])
}

enum UserRole {
  ADMIN
  EMPLOYEE
  SUPERVISOR
}

enum ClaimCategory {
  TRAVEL
  TRANSPORT
  MEAL
  MEDICAL
  WELLNESS
  HARDWARE
  OFFICE
  OTHER
}

enum ClaimStatus {
  SUBMITTED
  PENDING
  APPROVED
  REVIEWED
  REJECTED
}
enum PaymentType {
  PERSONAL
  COMPANY
}

enum XeroSyncStatus {
  NOT_SYNCED
  SYNCED
  ERROR
}

enum AttendanceStatus {
  ON_TIME
  LATE
  MISSING
  CLOCKED_IN
  CLOCKED_OUT
  ON_LEAVE
}

enum ApprovalKind {
  CLOCK_IN
  CLOCK_OUT
  BREAK
  OT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OTSubtype {
  LATE_REPLACEMENT
  OT_OFFSET
  UNRESOLVED
}

enum ClaimType {
  EXPENSE
  MILEAGE
}

enum LimitPeriod {
  PER_CLAIM
  MONTHLY
  YEARLY
}

enum LimitScope {
  PER_EMPLOYEE
  ORG_WIDE
}

enum MileageUnit {
  KM
  MILE
}

/// *
///  * Mirrors the `EmployeePayoutMethod` literal type in the org domain. Switched
///  * from a free String to enforce that callers can only ever store one of the
///  * two valid values.
///  *
///  * Backfill caveat for ops: any existing rows with values other than HOURLY /
///  * MONTHLY_BASED must be normalised before `prisma db push` will accept this
///  * change. (The previous DAILY_BASED value was renamed in 2026-05; old rows
///  * were migrated by raw SQL ahead of the schema rename.)
enum PayoutMethod {
  HOURLY
  MONTHLY_BASED
}
