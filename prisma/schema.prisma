/// Which annual file a `PayrollAnnualReport` row represents.
/// FORM_EA_BULK_PDF       — One Form EA per employee, concatenated.
/// FORM_E_CP8D_PDF        — Employer's annual return cover + CP8D.
/// CP8D_EMPLOYER_TXT      — `M{employerNo}_{year}.TXT`, employer row.
/// CP8D_EMPLOYEE_TXT      — `P{employerNo}_{year}.TXT`, one row per emp.
enum PayrollAnnualReportKind {
  FORM_EA_BULK_PDF
  FORM_E_CP8D_PDF
  CP8D_EMPLOYER_TXT
  CP8D_EMPLOYEE_TXT
}

/// Which downloadable file a `PayrollRunReport` row represents. The
/// modal on the run detail page renders one row per kind, grouped
/// into Reports / Statutory uploads / Payslips / Bank disbursement
/// sections.
enum PayrollReportKind {
  PAYROLL_SUMMARY_PDF
  PAYMENT_SCHEDULE_PDF
  DETAILED_CALCULATIONS_PDF
  /// LHDN MTD §E worksheet PDF — official LHDN-form layout with
  /// numbered sections (PCB(A) Normal / Yearly PCB / Yearly Tax / AR
  /// PCB / Net PCB), each LHDN variable in its own table card with
  /// abbreviation + full description + amount. Counterpart of
  /// DETAILED_CALCULATIONS_PDF for auditors expecting the official
  /// form layout.
  PCB_LHDN_FORM_PDF
  BULK_PAYSLIPS_PDF
  EPF_CSV
  SOCSO_EIS_TXT
  /// PERKESO ASSIST 2.0 combined contribution file — SOCSO + EIS +
  /// SKBBK (Skim LINDUNG 24 Jam) in one 278-char fixed-width text
  /// file. Effective Jun 2026. Differs from SOCSO_EIS_TXT only in
  /// that SKBBK employee amount populates positions 239-244 (was
  /// blank filler in v1). Grace period through Sep 2026 — admins can
  /// still upload the v1 file plus a separate SKBBK file during the
  /// transition.
  SOCSO_EIS_SKBBK_TXT
  PCB_TXT
  /// Public Bank ECP Payroll Excel — bulk salary disbursement file.
  /// Uploaded to PB enterprise > Bulk Payroll. Filename follows
  /// `{10-digit account}PR{DDMMYY}{NN}.xlsx`. Required configuration:
  /// `PayrollSettings.ecpPayorAccountNo`.
  BANK_PB_ECP_XLSX
}

