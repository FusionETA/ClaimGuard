generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                     String              @id @default(cuid())
  email                  String              @unique
  name                   String
  role                   UserRole
  organizationId         String?
  passwordHash           String
  avatarUrl              String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  adminOrganizations     AdminOrganization[] @relation("AdminOrganizations")
  approvalChainApprovals ApprovalChainStep[] @relation("ApproverChain")
  approvalChainSteps     ApprovalChainStep[] @relation("EmployeeChain")
  approvals              ApprovalRequest[]   @relation("EmployeeApprovals")
  approvalReviews        ApprovalRequest[]   @relation("ReviewerApprovals")
  attendance             AttendanceRecord[]  @relation("EmployeeAttendance")
  claims                 Claim[]             @relation("EmployeeClaims")
  reviews                Claim[]             @relation("AdminReviews")
  supervisedProfiles     EmployeeProfile[]   @relation("SupervisorReports")
  employeeProfile        EmployeeProfile?    @relation("EmployeeProfileUser")
  pushSubscriptions      PushSubscription[]
  organization           Organization?       @relation(fields: [organizationId], references: [id])
  xeroConnections        XeroConnection[]    @relation("XeroConnectedBy")
  managedProjects        XeroProject[]       @relation("ProjectManager")

  @@index([organizationId])
}

model Organization {
  id                       String              @id @default(cuid())
  name                     String              @unique
  claimCutoffDay           Int                 @default(25)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  workingHoursEnd          String              @default("18:00")
  workingHoursStart        String              @default("09:00")
  bankAccount              String?
  otRateNormalDay          Decimal             @default(1.50) @db.Decimal(4, 2)
  otRatePublicHoliday      Decimal             @default(3.00) @db.Decimal(4, 2)
  otRateRestDay            Decimal             @default(2.00) @db.Decimal(4, 2)
  otSalaryThreshold        Decimal             @default(4000.00) @db.Decimal(10, 2)
  publicHolidayInShiftRate Decimal             @default(2.00) @db.Decimal(4, 2)
  restDayInShiftRate       Decimal             @default(1.00) @db.Decimal(4, 2)
  geofenceRadiusMeters     Int                 @default(200)
  adminMembers             AdminOrganization[]
  chartAccounts            ChartOfAccount[]
  claims                   Claim[]
  users                    User[]
  xeroConnections          XeroConnection[]
  projects                 XeroProject[]
}

model AdminOrganization {
  id             String       @id @default(cuid())
  adminId        String
  organizationId String
  createdAt      DateTime     @default(now())
  admin          User         @relation("AdminOrganizations", fields: [adminId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([adminId, organizationId])
  @@index([adminId])
  @@index([organizationId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmployeeProfile {
  id                 String                      @id @default(cuid())
  userId             String                      @unique
  employeeId         String                      @unique
  project            String                      @map("department")
  jobTitle           String
  supervisorId       String?
  payoutMethod       String?
  preferredCurrency  String                      @default("USD")
  xeroConnectionId   String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  supervisor         User?                       @relation("SupervisorReports", fields: [supervisorId], references: [id])
  user               User                        @relation("EmployeeProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  xeroConnection     XeroConnection?             @relation(fields: [xeroConnectionId], references: [id])
  projectAssignments EmployeeProjectAssignment[]

  @@index([supervisorId])
  @@index([xeroConnectionId])
}

model EmployeeProjectAssignment {
  id                String          @id @default(cuid())
  employeeProfileId String
  projectId         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  project           XeroProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, projectId])
  @@index([employeeProfileId])
  @@index([projectId])
}

model Claim {
  id               String          @id @default(cuid())
  claimNumber      String          @unique
  title            String
  description      String          @db.Text
  category         ClaimCategory
  organizationId   String?
  chartOfAccountId String?
  amount           Decimal         @db.Decimal(10, 2)
  currency         String          @default("USD")
  spentAt          DateTime
  submittedAt      DateTime        @default(now())
  claimRunMonth    DateTime?
  reviewedAt       DateTime?
  payoutAt         DateTime?
  payViaAccountId  String?
  paymentType      PaymentType     @default(PERSONAL)
  status           ClaimStatus     @default(PENDING)
  receiptUrl       String?
  reviewNotes      String?         @db.Text
  employeeId       String
  reviewerId       String?
  xeroBillId       String?         @unique
  xeroBillRef      String?
  xeroSyncStatus   XeroSyncStatus  @default(NOT_SYNCED)
  xeroSyncError    String?         @db.Text
  xeroSyncedAt     DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  chartOfAccount   ChartOfAccount? @relation("ClaimAccount", fields: [chartOfAccountId], references: [id])
  payViaAccount    ChartOfAccount? @relation("ClaimPayVia", fields: [payViaAccountId], references: [id])
  employee         User            @relation("EmployeeClaims", fields: [employeeId], references: [id], onDelete: Cascade)
  organization     Organization?   @relation(fields: [organizationId], references: [id])
  reviewer         User?           @relation("AdminReviews", fields: [reviewerId], references: [id])

  @@index([organizationId, submittedAt])
  @@index([chartOfAccountId])
  @@index([payViaAccountId])
  @@index([employeeId, submittedAt])
  @@index([status, submittedAt])
  @@index([xeroSyncStatus])
  @@index([reviewerId], map: "Claim_reviewerId_fkey")
}

model ChartOfAccount {
  id               String          @id @default(cuid())
  organizationId   String
  xeroConnectionId String?
  xeroAccountId    String?
  code             String
  name             String
  type             String?
  status           String?
  isSelectable     Boolean         @default(false)
  isCustom         Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  isBankAccount    Boolean         @default(false)
  isDisabled       Boolean         @default(false)
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  xeroConnection   XeroConnection? @relation(fields: [xeroConnectionId], references: [id], onDelete: Cascade)
  claims           Claim[]         @relation("ClaimAccount")
  payViaClaims     Claim[]         @relation("ClaimPayVia")

  @@unique([xeroConnectionId, xeroAccountId])
  @@unique([organizationId, code])
  @@index([organizationId, xeroConnectionId, isSelectable])
  @@index([organizationId, isBankAccount])
}

model XeroConnection {
  id                   String            @id @default(cuid())
  provider             String            @default("xero")
  organizationId       String
  tenantId             String            @unique
  tenantName           String
  tenantType           String?
  accessToken          String            @db.Text
  refreshToken         String            @db.Text
  scope                String            @db.Text
  tokenType            String
  accessTokenExpiresAt DateTime
  connectedByAdminId   String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  chartAccounts        ChartOfAccount[]
  employeeProfiles     EmployeeProfile[]
  connectedByAdmin     User?             @relation("XeroConnectedBy", fields: [connectedByAdminId], references: [id])
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  xeroProjects         XeroProject[]

  @@unique([organizationId, tenantId])
  @@index([organizationId])
  @@index([provider])
  @@index([connectedByAdminId])
}

model XeroProject {
  id                String                      @id @default(cuid())
  organizationId    String
  xeroConnectionId  String?
  xeroProjectId     String?
  name              String
  status            String?
  contactId         String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  isManual          Boolean                     @default(false)
  location          String?
  latitude          Float?
  longitude         Float?
  projectManagerId  String?
  isDisabled        Boolean                     @default(false)
  assignedEmployees EmployeeProjectAssignment[]
  attendanceRecords AttendanceRecord[]          @relation("AttendanceRecordProject")
  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectManager    User?                       @relation("ProjectManager", fields: [projectManagerId], references: [id])
  xeroConnection    XeroConnection?             @relation(fields: [xeroConnectionId], references: [id], onDelete: Cascade)

  @@unique([xeroConnectionId, xeroProjectId])
  @@index([xeroConnectionId, name])
  @@index([organizationId], map: "XeroProject_organizationId_fkey")
  @@index([projectManagerId])
}

model AttendanceRecord {
  id          String           @id @default(cuid())
  employeeId  String
  date        DateTime
  timeIn      DateTime?
  timeOut     DateTime?
  durationMin Int?
  lateByMin   Int?
  location    String?
  project     String?
  projectId   String?
  status      AttendanceStatus @default(MISSING)
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  employee    User             @relation("EmployeeAttendance", fields: [employeeId], references: [id], onDelete: Cascade)
  projectRef  XeroProject?     @relation("AttendanceRecordProject", fields: [projectId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@index([status, date])
  @@index([projectId])
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  employeeId  String
  reviewerId  String?
  kind        ApprovalKind
  status      ApprovalStatus @default(PENDING)
  date        DateTime
  eventAt     DateTime?
  title       String
  detail      String         @db.Text
  location    String?
  otSubtype   OTSubtype?
  lateMinutes Int?
  offsetRef   String?
  reviewNotes String?        @db.Text
  submittedAt DateTime       @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     String?
  employee    User           @relation("EmployeeApprovals", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer    User?          @relation("ReviewerApprovals", fields: [reviewerId], references: [id])

  @@index([employeeId, date])
  @@index([status, date])
  @@index([kind, status])
  @@index([reviewerId], map: "ApprovalRequest_reviewerId_fkey")
}

model ApprovalChainStep {
  id         String   @id @default(cuid())
  employeeId String
  step       Int
  approverId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  approver   User     @relation("ApproverChain", fields: [approverId], references: [id])
  employee   User     @relation("EmployeeChain", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, step])
  @@index([employeeId])
  @@index([approverId])
}

enum UserRole {
  ADMIN
  EMPLOYEE
  SUPERVISOR
}

enum ClaimCategory {
  TRAVEL
  TRANSPORT
  MEAL
  MEDICAL
  WELLNESS
  HARDWARE
  OFFICE
  OTHER
}

enum ClaimStatus {
  SUBMITTED
  PENDING
  APPROVED
  REJECTED
  PAID
  SETTLED
}

enum PaymentType {
  PERSONAL
  COMPANY
}

enum XeroSyncStatus {
  NOT_SYNCED
  SYNCED
  ERROR
}

enum AttendanceStatus {
  ON_TIME
  LATE
  MISSING
  CLOCKED_IN
  CLOCKED_OUT
  ON_LEAVE
}

enum ApprovalKind {
  CLOCK_IN
  CLOCK_OUT
  BREAK
  OT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OTSubtype {
  LATE_REPLACEMENT
  OT_OFFSET
  UNRESOLVED
}
