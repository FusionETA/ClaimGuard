generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  EMPLOYEE
  SUPERVISOR
}

enum ClaimCategory {
  TRAVEL
  TRANSPORT
  MEAL
  MEDICAL
  WELLNESS
  HARDWARE
  OFFICE
  OTHER
}

enum ClaimStatus {
  SUBMITTED
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum XeroSyncStatus {
  NOT_SYNCED
  SYNCED
  ERROR
}

enum AttendanceStatus {
  ON_TIME
  LATE
  MISSING
  CLOCKED_IN
  CLOCKED_OUT
  ON_LEAVE
}

enum ApprovalKind {
  CLOCK_IN
  CLOCK_OUT
  BREAK
  OT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OTSubtype {
  LATE_REPLACEMENT
  OT_OFFSET
  UNRESOLVED
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  name               String
  role               UserRole
  organizationId     String?
  passwordHash       String
  avatarUrl          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  employeeProfile    EmployeeProfile?   @relation("EmployeeProfileUser")
  supervisedProfiles EmployeeProfile[]  @relation("SupervisorReports")
  claims             Claim[]            @relation("EmployeeClaims")
  reviews            Claim[]            @relation("AdminReviews")
  pushSubscriptions  PushSubscription[]
  xeroConnections    XeroConnection[]   @relation("XeroConnectedBy")
  attendance         AttendanceRecord[] @relation("EmployeeAttendance")
  approvals          ApprovalRequest[]  @relation("EmployeeApprovals")
  approvalReviews    ApprovalRequest[]  @relation("ReviewerApprovals")

  @@index([organizationId])
}

model Organization {
  id                String           @id @default(cuid())
  name              String           @unique
  claimCutoffDay    Int              @default(25)
  workingHoursStart String           @default("09:00")
  workingHoursEnd   String           @default("18:00")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  users             User[]
  claims            Claim[]
  xeroConnections   XeroConnection[]
  chartAccounts     ChartOfAccount[]
  projects          XeroProject[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmployeeProfile {
  id                String          @id @default(cuid())
  userId            String          @unique
  employeeId        String          @unique
  project           String          @map("department")
  jobTitle          String
  supervisorId      String?
  payoutMethod      String?
  preferredCurrency String          @default("USD")
  xeroConnectionId  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation("EmployeeProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  supervisor        User?           @relation("SupervisorReports", fields: [supervisorId], references: [id], onDelete: SetNull)
  xeroConnection    XeroConnection? @relation(fields: [xeroConnectionId], references: [id], onDelete: SetNull)

  @@index([supervisorId])
  @@index([xeroConnectionId])
}

model Claim {
  id               String         @id @default(cuid())
  claimNumber      String         @unique
  title            String
  description      String         @db.Text
  category         ClaimCategory
  organizationId   String?
  chartOfAccountId String?
  amount           Decimal        @db.Decimal(10, 2)
  currency         String         @default("USD")
  spentAt          DateTime
  submittedAt      DateTime       @default(now())
  claimRunMonth    DateTime?
  reviewedAt       DateTime?
  payoutAt         DateTime?
  status           ClaimStatus    @default(PENDING)
  receiptUrl       String?
  reviewNotes      String?        @db.Text
  employeeId       String
  reviewerId       String?
  xeroBillId       String?        @unique
  xeroBillRef      String?
  xeroSyncStatus   XeroSyncStatus @default(NOT_SYNCED)
  xeroSyncError    String?        @db.Text
  xeroSyncedAt     DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organization     Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  chartOfAccount   ChartOfAccount? @relation(fields: [chartOfAccountId], references: [id], onDelete: SetNull)
  employee         User           @relation("EmployeeClaims", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer         User?          @relation("AdminReviews", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([organizationId, submittedAt])
  @@index([chartOfAccountId])
  @@index([employeeId, submittedAt])
  @@index([status, submittedAt])
  @@index([xeroSyncStatus])
}

model ChartOfAccount {
  id               String          @id @default(cuid())
  organizationId   String
  xeroConnectionId String?
  xeroAccountId    String?
  code             String
  name             String
  type             String?
  status           String?
  isSelectable     Boolean         @default(false)
  isCustom         Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  xeroConnection   XeroConnection? @relation(fields: [xeroConnectionId], references: [id], onDelete: Cascade)
  claims           Claim[]

  @@unique([xeroConnectionId, xeroAccountId])
  @@unique([organizationId, code])
  @@index([organizationId, xeroConnectionId, isSelectable])
}

model XeroConnection {
  id                   String           @id @default(cuid())
  provider             String           @default("xero")
  organizationId       String
  tenantId             String           @unique
  tenantName           String
  tenantType           String?
  accessToken          String           @db.Text
  refreshToken         String           @db.Text
  scope                String           @db.Text
  tokenType            String
  accessTokenExpiresAt DateTime
  connectedByAdminId   String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedByAdmin     User?            @relation("XeroConnectedBy", fields: [connectedByAdminId], references: [id], onDelete: SetNull)
  chartAccounts        ChartOfAccount[]
  xeroProjects         XeroProject[]
  employeeProfiles     EmployeeProfile[]

  @@unique([organizationId, tenantId])
  @@index([organizationId])
  @@index([provider])
  @@index([connectedByAdminId])
}

model XeroProject {
  id               String         @id @default(cuid())
  organizationId   String
  xeroConnectionId String
  xeroProjectId    String
  name             String
  status           String?
  contactId        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  xeroConnection   XeroConnection @relation(fields: [xeroConnectionId], references: [id], onDelete: Cascade)

  @@unique([xeroConnectionId, xeroProjectId])
  @@index([xeroConnectionId, name])
}

model AttendanceRecord {
  id          String           @id @default(cuid())
  employeeId  String
  date        DateTime
  timeIn      DateTime?
  timeOut     DateTime?
  durationMin Int?
  lateByMin   Int?
  location    String?
  project     String?
  status      AttendanceStatus @default(MISSING)
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  employee    User             @relation("EmployeeAttendance", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@index([status, date])
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  employeeId  String
  reviewerId  String?
  kind        ApprovalKind
  status      ApprovalStatus @default(PENDING)
  date        DateTime       // event day
  eventAt     DateTime?      // exact timestamp for clock events
  title       String
  detail      String         @db.Text
  location    String?
  project     String?
  // OT-specific
  otSubtype   OTSubtype?
  lateMinutes Int?
  offsetRef   String?
  // review lifecycle
  reviewNotes String?        @db.Text
  submittedAt DateTime       @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  employee    User           @relation("EmployeeApprovals", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer    User?          @relation("ReviewerApprovals", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([employeeId, date])
  @@index([status, date])
  @@index([kind, status])
}
